{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lites.dev/schemas/product-behavior-manifest.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion","sourceCommit","createdAt","components","impactRules","manifestHash"],
  "properties": {
    "manifestVersion":{"type":"string"},
    "sourceCommit":{"type":"string","minLength":7},
    "createdAt":{"type":"string","format":"date-time"},
    "components":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["kind","id","hash","pilotScope"],"properties":{"kind":{"enum":["frontend_chunk","shared_dependency","api_contract","event_contract","model","prompt","tool","profile","policy","ontology","content","feature_flag"]},"id":{"type":"string"},"hash":{"type":"string"},"pilotScope":{"type":"boolean"}}}},
    "impactRules":{"type":"object"},
    "manifestHash":{"type":"string"}
  }
}
