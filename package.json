{
  "name": "lites",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev:backend",
    "dev:backend": "cd backend && go run .",
    "dev:frontend": "npm run dev --workspace @lites/frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && go build -o bin/lites-backend .",
    "build:frontend": "npm run build --workspace @lites/frontend"
  }
}
