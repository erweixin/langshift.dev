{
  "name": "lites",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "make dev",
    "typegen": "node scripts/typegen.mjs",
    "dev:backend": "cd backend && go run ./cmd/lites",
    "dev:frontend": "pnpm --filter @lites/frontend dev",
    "build": "make build",
    "build:backend": "cd backend && go build -o bin/lites-backend ./cmd/lites",
    "build:frontend": "pnpm --filter @lites/frontend build"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.4"
  }
}
