{
  "name": "lites",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "description": "Production-first Lites cloud agent and capability migration product",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.19"
    }
  },
  "scripts": {
    "web:dev": "npm run dev --workspace @lites/web",
    "web:build": "npm run build --workspace @lites/web",
    "web:lint": "npm run lint --workspace @lites/web",
    "web:typecheck": "npm run typecheck --workspace @lites/web",
    "web:test": "npm run test --workspace @lites/web",
    "web:test:e2e": "npm run test:e2e --workspace @lites/web",
    "web:contracts": "npm run api:generate --workspace @lites/web",
    "backend:test": "GOCACHE=/tmp/lites-go-build GOMODCACHE=/tmp/lites-go-mod go test ./...",
    "backend:test:race": "GOCACHE=/tmp/lites-go-build GOMODCACHE=/tmp/lites-go-mod go test -race ./...",
    "backend:test:postgres": "./scripts/foundation-postgres-smoke.sh",
    "backend:test:migrations": "./scripts/stage2-migration-smoke.sh",
    "contracts:generate": "node scripts/generate-phase1-assets.mjs",
    "contracts:lint": "node scripts/lint-phase1-assets.mjs",
    "contracts:lint:stage3": "node scripts/lint-stage3-contract-amendment.mjs",
    "contracts:lint:behavior": "node scripts/lint-behavior-control-plane-contract.mjs",
    "contracts:db-smoke": "./scripts/database-contract-smoke.sh",
    "contracts:approvals": "node scripts/verify-stage1-approvals.mjs",
    "contracts:approvals:self-test": "node scripts/verify-stage1-approvals.mjs --self-test",
    "contracts:approval:sign": "node scripts/sign-stage1-approval.mjs",
    "contracts:approval:sign:self-test": "node scripts/sign-stage1-approval.mjs --self-test",
    "contracts:review-packet": "node scripts/create-stage1-review-packet.mjs",
    "contracts:gate-report": "node scripts/build-stage1-gate-report.mjs",
    "gate:stage1:technical": "npm test && npm run contracts:db-smoke && npm run contracts:gate-report",
    "gate:stage1": "npm test && npm run contracts:db-smoke && npm run contracts:approvals && npm run contracts:gate-report",
    "gate:stage3:child-orchestration": "./scripts/stage3-child-orchestration-fault-gate.sh",
    "gate:stage3:execution-delivery": "./scripts/stage3-execution-delivery-fault-gate.sh",
    "gate:stage3:approval-expiry": "./scripts/stage3-approval-expiry-fault-gate.sh",
    "gate:stage3:outcome-unknown": "./scripts/stage3-outcome-unknown-fault-gate.sh",
    "gate:stage3:effect-ledger": "./scripts/stage3-effect-ledger-gate.sh",
    "gate:stage3:effect-ledger:self-test": "node scripts/test-stage3-effect-ledger-verifier.mjs",
    "gate:stage3:workspace-half-commit": "./scripts/stage3-workspace-half-commit-fault-gate.sh",
    "gate:stage3:realtime-loss": "./scripts/stage3-realtime-loss-fault-gate.sh",
    "gate:stage3:state-machines": "./scripts/stage3-state-machine-gate.sh",
    "gate:stage3:anonymous-claim-repair": "./scripts/stage3-anonymous-claim-repair-gate.sh",
    "gate:stage3:llm-manifest": "./scripts/stage3-llm-manifest-gate.sh",
    "gate:stage3:provider-egress": "./scripts/stage3-provider-egress-gate.sh",
    "gate:stage3:safety-samples": "./scripts/stage3-safety-samples-gate.sh",
    "gate:stage3:capacity": "./scripts/stage3-capacity-gate.sh",
    "gate:stage3:capacity:observe": "node scripts/run-stage3-capacity-observer.mjs",
    "gate:stage3:capacity:observer:self-test": "node scripts/test-stage3-capacity-observer.mjs",
    "gate:stage3:capacity:self-test": "node scripts/test-stage3-capacity-verifier.mjs",
    "gate:stage3:capacity:chart": "./scripts/stage3-reference-capacity-chart-gate.sh",
    "gate:stage3:capacity:provider-chart": "./scripts/stage3-reference-provider-chart-gate.sh",
    "gate:stage3:capacity:seed": "node scripts/seed-stage3-reference-capacity.mjs",
    "gate:stage3:capacity:seed:self-test": "node scripts/test-stage3-reference-capacity-seeder.mjs",
    "gate:stage3:acceptance": "./scripts/stage3-acceptance-gate.sh",
    "gate:stage3:acceptance:self-test": "node scripts/test-stage3-acceptance-verifier.mjs",
    "release:agent-assets": "./scripts/build-agent-release-assets.sh",
    "content:stage4:build": "node scripts/build-stage4-content-release.mjs",
    "content:stage4:lint": "node scripts/lint-stage4-content-release.mjs",
    "gate:stage4:content": "npm run content:stage4:build && npm run content:stage4:lint",
    "contracts:test": "npm run contracts:generate && npm run contracts:gate-report && npm run contracts:lint && npm run contracts:approvals:self-test && npm run contracts:approval:sign:self-test && npm run contracts:gate-report",
    "test": "npm run contracts:test && npm run web:lint && npm run web:typecheck && npm run web:test && npm run backend:test"
  }
}
