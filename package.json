    "gate:stage3:capacity:provider-chart": "./scripts/stage3-reference-provider-chart-gate.sh",
    "gate:stage3:capacity:seed": "node scripts/seed-stage3-reference-capacity.mjs",
    "gate:stage3:capacity:seed:self-test": "node scripts/test-stage3-reference-capacity-seeder.mjs",
