# This file contains paths and public configuration only. Secret values live in
# root-owned 0400 files under /etc/lites/secrets.
ALLOW_INSECURE_DEVELOPMENT=false
DATABASE_URL_FILE=/etc/lites/secrets/runtime-database-url
STORE_EPOCH_AUTHORITY_URL=https://store-epoch.internal:8443/v1/store-epoch
STORE_EPOCH_TOKEN_FILE=/etc/lites/secrets/store-epoch-token
STORE_EPOCH_CA_FILE=/etc/lites/pki/store-epoch-ca.crt
STORE_EPOCH_CLIENT_CERT_FILE=/etc/lites/pki/runtime-host-client.crt
STORE_EPOCH_CLIENT_KEY_FILE=/etc/lites/secrets/runtime-host-client.key
STORE_EPOCH_TLS_SERVER_NAME=store-epoch.internal

RUNTIME_CAPABILITY_KEYRING_FILE=/etc/lites/pki/runtime-capability-keyring.json
RUNTIME_CAPABILITY_ISSUER=event-service
RUNTIME_CAPABILITY_AUDIENCE=runtime-manager
RUNTIME_ID_KEY_FILE=/etc/lites/secrets/runtime-id-key
RUNTIME_TOKEN_PEPPER_FILE=/etc/lites/secrets/runtime-token-pepper
RUNTIME_HOST_CONTROL_TOKEN_FILE=/etc/lites/secrets/runtime-host-control-token
RUNTIME_OWNERSHIP_KEY_FILE=/etc/lites/secrets/runtime-ownership-key

RUNTIME_HOST_ID=replace-with-stable-instance-id
RUNTIME_POOL_KEY=runtime-untrusted
RUNTIME_ARCHITECTURE=x86_64
RUNTIME_AVAILABILITY_ZONE=replace-with-zone
RUNTIME_KERNEL_CATALOG_HASH=replace-with-catalog-hash
RUNTIME_ROOTFS_CATALOG_HASH=replace-with-catalog-hash
RUNTIME_SCRATCH_DIGEST=sha256:replace-with-64-hex-digits
RUNTIME_CAPACITY_VCPU=32
RUNTIME_CAPACITY_MEMORY_MIB=65536
RUNTIME_CAPACITY_DISK_MIB=1048576
RUNTIME_CAPACITY_SESSIONS=64
RUNTIME_HEARTBEAT_INTERVAL=10s
RUNTIME_HEARTBEAT_TTL=30s
RUNTIME_RECOVERY_INTERVAL=2s
RUNTIME_SHUTDOWN_TIMEOUT=45s

JAILER_PATH=/usr/local/libexec/firecracker/jailer
JAILER_DIGEST=sha256:replace-with-64-hex-digits
FIRECRACKER_PATH=/usr/local/libexec/firecracker/firecracker
FIRECRACKER_BINARY_DIGEST=sha256:replace-with-64-hex-digits
FIRECRACKER_CHROOT_BASE_DIR=/var/lib/lites/firecracker
FIRECRACKER_PARENT_CGROUP=lites/runtime
FIRECRACKER_UID=1000
FIRECRACKER_GID=1000
FIRECRACKER_CPU_QUOTA_MICROS=200000
FIRECRACKER_CPU_PERIOD_MICROS=100000
FIRECRACKER_MEMORY_MAX_BYTES=2147483648
FIRECRACKER_PIDS_MAX=512
FIRECRACKER_FILE_SIZE_MAX_BYTES=17179869184
FIRECRACKER_NOFILE_MAX=4096
FIRECRACKER_NETWORK_NAMESPACE=/run/netns/lites-runtime-untrusted
FIRECRACKER_KERNEL_PATH=/var/lib/lites/runtime-assets/vmlinux
FIRECRACKER_KERNEL_DIGEST=sha256:replace-with-64-hex-digits
FIRECRACKER_ROOTFS_PATH=/var/lib/lites/runtime-assets/rootfs.ext4
FIRECRACKER_ROOTFS_DIGEST=sha256:replace-with-64-hex-digits
FIRECRACKER_SCRATCH_PATH=/var/lib/lites/runtime-assets/scratch.ext4

S3_REGION=replace-with-region
S3_PAYLOAD_BUCKET=replace-with-payload-bucket
S3_PAYLOAD_PREFIX=restricted
S3_SERVER_SIDE_ENCRYPTION=aws:kms
S3_KMS_KEY_ID=replace-with-kms-key-id
VAULT_ADDR=https://vault.internal:8200
VAULT_KV_MOUNT=secret
VAULT_TOKEN_FILE=/etc/lites/secrets/vault-token
VAULT_CACERT=/etc/lites/pki/vault-ca.crt
VAULT_PAYLOAD_KEY_PREFIX=lites/payload-keys

LISTEN_ADDRESS=0.0.0.0:8443
HEALTH_ADDRESS=127.0.0.1:8085
SERVER_TLS_CERT_FILE=/etc/lites/pki/runtime-host-server.crt
SERVER_TLS_KEY_FILE=/etc/lites/secrets/runtime-host-server.key
SERVER_CLIENT_CA_FILE=/etc/lites/pki/runtime-control-client-ca.crt
SERVER_ALLOWED_CLIENT_SPIFFE_ID=spiffe://lites.internal/tool-worker
LITES_ENVIRONMENT=production
LITES_VERSION=replace-with-release-version
LITES_REGION=replace-with-region
OTLP_GRPC_ENDPOINT=otel-collector.internal:4317
OTLP_ROOT_CA_FILE=/etc/lites/pki/otel-ca.crt
OTLP_BEARER_TOKEN_FILE=/etc/lites/secrets/otel-token
OTLP_TLS_SERVER_NAME=otel-collector.internal
TRACE_SAMPLE_RATIO=0.10
