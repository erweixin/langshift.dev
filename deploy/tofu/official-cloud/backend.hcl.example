# Supply these values through the deployment environment. The bucket and lock
# table live in a dedicated infrastructure account, outside both application
# cells, with versioning, KMS encryption, MFA delete and break-glass access.
bucket         = "REPLACE_WITH_BOOTSTRAP_STATE_BUCKET"
key            = "official-cloud/lites.tfstate"
region         = "REPLACE_WITH_STATE_REGION"
encrypt        = true
kms_key_id     = "REPLACE_WITH_STATE_KMS_KEY_ARN"
dynamodb_table = "REPLACE_WITH_STATE_LOCK_TABLE"
