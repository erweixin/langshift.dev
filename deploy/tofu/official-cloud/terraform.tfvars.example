us = {
  region                   = "us-east-1"
  name                     = "lites-us-1"
  availability_zones       = ["us-east-1a", "us-east-1b", "us-east-1c"]
  vpc_cidr                 = "10.40.0.0/16"
  public_subnet_cidrs      = ["10.40.0.0/24", "10.40.1.0/24", "10.40.2.0/24"]
  application_subnet_cidrs = ["10.40.16.0/20", "10.40.32.0/20", "10.40.48.0/20"]
  data_subnet_cidrs        = ["10.40.64.0/24", "10.40.65.0/24", "10.40.66.0/24"]
  kubernetes_version       = "REPLACE_WITH_PINNED_SUPPORTED_VERSION"
  eks_admin_principals     = ["arn:aws:iam::111111111111:role/lites-platform-admin"]
  eks_core_addon_versions = {
    vpc-cni                = "REPLACE_WITH_PINNED_VERSION"
    coredns                = "REPLACE_WITH_PINNED_VERSION"
    kube-proxy             = "REPLACE_WITH_PINNED_VERSION"
    eks-pod-identity-agent = "REPLACE_WITH_PINNED_VERSION"
    aws-ebs-csi-driver     = "REPLACE_WITH_PINNED_VERSION"
  }
  aurora_engine_version        = "REPLACE_WITH_PINNED_AURORA_POSTGRESQL_16_VERSION"
  valkey_engine_version        = "REPLACE_WITH_PINNED_VALKEY_VERSION"
  recovery_operator_principals = ["arn:aws:iam::111111111111:role/lites-recovery-approver"]
}

