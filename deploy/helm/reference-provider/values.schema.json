{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["image","sourceCommit","version","region","priorityClassName","replicas","existingSecret","model","provider","service","resources","nodeSelector","tolerations","gatewayNamespaceSelector","gatewayPodSelector","gatewayIngressCIDRs","monitoringNamespaceSelector","monitoringPodSelector"],
  "properties": {
    "image": {"type":"object","additionalProperties":false,"required":["repository","digest","pullPolicy"],"properties":{"repository":{"type":"string","minLength":1},"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"pullPolicy":{"enum":["IfNotPresent","Always"]}}},
    "sourceCommit": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "version": {"type":"string","minLength":1},
    "region": {"type":"string","minLength":1},
    "priorityClassName": {"type":"string","minLength":1},
    "replicas": {"type":"integer","minimum":3,"maximum":20},
    "existingSecret": {"type":"string","minLength":1},
    "model": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "provider": {"type":"object","additionalProperties":false,"required":["localHold","replayHold","replayRateNumerator","runtimeArtifactBytes","runtimeHoldMilliseconds","maximumRequestBytes","maximumConcurrentRequests"],"properties":{
      "localHold":{"type":"string","pattern":"^([1-9][0-9]*)(ms|s)$"},
      "replayHold":{"type":"string","pattern":"^(0s|[1-9][0-9]*(ms|s))$"},
      "replayRateNumerator":{"type":"integer","minimum":1,"maximum":255},
      "runtimeArtifactBytes":{"type":"integer","minimum":1048576,"maximum":8388608},
      "runtimeHoldMilliseconds":{"type":"integer","minimum":100,"maximum":10000},
      "maximumRequestBytes":{"type":"integer","minimum":1024,"maximum":67108864},
      "maximumConcurrentRequests":{"type":"integer","minimum":200,"maximum":100000}
    }},
    "service": {"type":"object","additionalProperties":false,"required":["annotations","loadBalancerClass","loadBalancerSourceRanges","externalTrafficPolicy","apiPort","healthPort"],"properties":{
      "annotations":{"type":"object","additionalProperties":{"type":"string"}},
      "loadBalancerClass":{"type":"string"},
      "loadBalancerSourceRanges":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^[0-9a-fA-F:.]+/[0-9]+$"}},
      "externalTrafficPolicy":{"const":"Local"},
      "apiPort":{"const":443},
      "healthPort":{"type":"integer","minimum":1024,"maximum":65535}
    }},
    "resources": {"type":"object"},
    "nodeSelector": {"type":"object"},
    "tolerations": {"type":"array"},
    "gatewayNamespaceSelector": {"type":"object","minProperties":1},
    "gatewayPodSelector": {"type":"object","minProperties":1},
    "gatewayIngressCIDRs": {"type":"array","minItems":1,"items":{"type":"string","pattern":"^[0-9a-fA-F:.]+/[0-9]+$"}},
    "monitoringNamespaceSelector": {"type":"object","minProperties":1},
    "monitoringPodSelector": {"type":"object","minProperties":1}
  }
}
