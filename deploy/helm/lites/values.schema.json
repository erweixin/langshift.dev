{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["fullnameOverride", "global", "workloads", "migration"],
  "properties": {
    "fullnameOverride": {"type": "string", "minLength": 1, "maxLength": 40},
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "region", "cell", "version", "imageRegistry", "imagePullPolicy", "priorityClassName", "traceSampleRatio", "otlpGrpcEndpoint", "otlpTlsServerName", "edgeNamespace", "monitoringNamespace", "dnsNamespace", "dnsPodLabels", "externalSecretStore", "externalSecretRefreshInterval"],
      "properties": {
        "environment": {"const": "production"},
        "region": {"type": "string"},
        "cell": {"type": "string"},
        "version": {"type": "string"},
        "imageRegistry": {"type": "string", "minLength": 1},
        "imagePullPolicy": {"enum": ["IfNotPresent", "Always", "Never"]},
        "priorityClassName": {"type": "string"},
        "traceSampleRatio": {"type": "string", "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"},
        "otlpGrpcEndpoint": {"type": "string"},
        "otlpTlsServerName": {"type": "string"},
        "edgeNamespace": {"type": "string", "minLength": 1},
        "monitoringNamespace": {"type": "string", "minLength": 1},
        "dnsNamespace": {"type": "string", "minLength": 1},
        "dnsPodLabels": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
        "externalSecretStore": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {"kind": {"enum": ["SecretStore", "ClusterSecretStore"]}, "name": {"type": "string"}}
        },
        "externalSecretRefreshInterval": {"type": "string", "pattern": "^[1-9][0-9]*(s|m|h)$"}
      }
    },
    "workloads": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api-gateway", "identity-service", "identity-import-worker", "identity-mail-worker", "outbox-publisher", "store-epoch-authority"],
      "properties": {
        "api-gateway": {"$ref": "#/$defs/workload"},
        "identity-service": {"$ref": "#/$defs/workload"},
        "identity-import-worker": {"$ref": "#/$defs/workload"},
        "identity-mail-worker": {"$ref": "#/$defs/workload"},
        "outbox-publisher": {"$ref": "#/$defs/workload"},
        "store-epoch-authority": {"$ref": "#/$defs/workload"}
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "existingSecret", "databaseUrlKey", "activeDeadlineSeconds", "externalEgress"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/$defs/image"},
        "existingSecret": {"type": "string"},
        "databaseUrlKey": {"type": "string", "minLength": 1},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 60, "maximum": 3600},
        "externalEgress": {"$ref": "#/$defs/egress"}
      }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^$|^sha256:[0-9a-f]{64}$"}
      }
    },
    "egress": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cidr", "ports"],
        "properties": {
          "cidr": {"type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"},
          "ports": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 65535}}
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "replicas", "image", "externalSecretRemoteKey", "service", "health", "autoscaling", "resources", "requiredEnv", "env", "externalEgress"],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicas": {"type": "integer", "minimum": 3},
        "image": {"$ref": "#/$defs/image"},
        "externalSecretRemoteKey": {"type": "string"},
        "service": {
          "type": "object", "additionalProperties": false, "required": ["enabled", "port"],
          "properties": {"enabled": {"type": "boolean"}, "port": {"type": "integer", "minimum": 0, "maximum": 65535}}
        },
        "health": {
          "type": "object", "additionalProperties": false, "required": ["type", "port"],
          "properties": {"type": {"enum": ["http", "tcp"]}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}
        },
        "autoscaling": {
          "type": "object", "additionalProperties": false, "required": ["enabled", "minReplicas", "maxReplicas", "cpuUtilization", "memoryUtilization"],
          "properties": {
            "enabled": {"type": "boolean"}, "minReplicas": {"type": "integer", "minimum": 3}, "maxReplicas": {"type": "integer", "minimum": 3},
            "cpuUtilization": {"type": "integer", "minimum": 1, "maximum": 100}, "memoryUtilization": {"type": "integer", "minimum": 1, "maximum": 100}
          }
        },
        "resources": {"type": "object"},
        "requiredEnv": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}},
        "env": {"type": "object", "additionalProperties": {"type": "string"}},
        "externalEgress": {"$ref": "#/$defs/egress"}
      }
    }
  }
}
