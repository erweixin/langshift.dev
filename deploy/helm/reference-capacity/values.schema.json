{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "sourceCommit", "version", "region", "priorityClassName", "existingSecret", "dataset", "gateway", "telemetry", "controller", "service", "resources", "nodeSelector", "tolerations", "observerNamespaceSelector", "observerPodSelector", "monitoringNamespaceSelector", "monitoringPodSelector", "gatewayEgressCIDRs", "telemetryEgressCIDRs", "dnsNamespaceSelector", "dnsPodSelector"],
  "properties": {
    "image": {"type":"object","additionalProperties":false,"required":["repository","digest","pullPolicy"],"properties":{"repository":{"type":"string","minLength":1},"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"pullPolicy":{"enum":["IfNotPresent","Always"]}}},
    "sourceCommit": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "version": {"type":"string","minLength":1},
    "region": {"type":"string","minLength":1},
    "priorityClassName": {"type":"string","minLength":1},
    "existingSecret": {"type":"string","minLength":1},
    "dataset": {"type":"object","additionalProperties":false,"required":["existingPVC","file"],"properties":{"existingPVC":{"type":"string","minLength":1},"file":{"const":"/run/capacity/dataset.json"}}},
    "gateway": {"type":"object","additionalProperties":false,"required":["url","tlsServerName","publicOrigin"],"properties":{"url":{"type":"string","pattern":"^https://"},"tlsServerName":{"type":"string","minLength":1},"publicOrigin":{"type":"string","pattern":"^https://"}}},
    "telemetry": {"type":"object","additionalProperties":false,"required":["endpoint","tlsServerName","traceSampleRatio"],"properties":{"endpoint":{"type":"string","pattern":"^[^:]+:[0-9]+$"},"tlsServerName":{"type":"string","minLength":1},"traceSampleRatio":{"type":"string","pattern":"^(0(\\.[0-9]+)?|1(\\.0+)?)$"}}},
    "controller": {"type":"object","additionalProperties":false,"required":["warmupDuration","requestTimeout","maximumInflight","maximumErrorRatio"],"properties":{"warmupDuration":{"type":"string","pattern":"^([1-9][0-9]*)(s|m)$"},"requestTimeout":{"type":"string","pattern":"^([1-9][0-9]*)(s|m)$"},"maximumInflight":{"type":"integer","minimum":500,"maximum":100000},"maximumErrorRatio":{"type":"string","pattern":"^0\\.0{2,}[0-9]+$"}}},
    "service": {"type":"object","additionalProperties":false,"required":["port","metricsPort"],"properties":{"port":{"type":"integer","minimum":1024,"maximum":65535},"metricsPort":{"type":"integer","minimum":1024,"maximum":65535}}},
    "resources": {"type":"object"},
    "nodeSelector": {"type":"object"},
    "tolerations": {"type":"array"},
    "observerNamespaceSelector": {"type":"object"},
    "observerPodSelector": {"type":"object"},
    "monitoringNamespaceSelector": {"type":"object"},
    "monitoringPodSelector": {"type":"object"},
    "gatewayEgressCIDRs": {"type":"array","minItems":1,"items":{"type":"string"}},
    "telemetryEgressCIDRs": {"type":"array","minItems":1,"items":{"type":"string"}},
    "dnsNamespaceSelector": {"type":"object"},
    "dnsPodSelector": {"type":"object"}
  }
}
