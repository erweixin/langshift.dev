{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["cell", "region", "storage", "externalSecret", "namespaces", "dnsPodLabels"],
  "properties": {
    "cell": {"type": "string", "minLength": 3},
    "region": {"enum": ["US", "EU"]},
    "storage": {
      "type": "object", "additionalProperties": false, "required": ["className", "kmsKeyId"],
      "properties": {
        "className": {"type": "string", "minLength": 1},
        "kmsKeyId": {"type": "string", "pattern": "^arn:aws:kms:[a-z0-9-]+:[0-9]{12}:key/[0-9a-f-]{36}$"}
      }
    },
    "externalSecret": {
      "type": "object", "additionalProperties": false, "required": ["refreshInterval", "store", "remoteKey"],
      "properties": {
        "refreshInterval": {"type": "string", "pattern": "^[1-9][0-9]*(s|m|h)$"},
        "remoteKey": {"type": "string", "minLength": 1},
        "store": {
          "type": "object", "additionalProperties": false, "required": ["kind", "name"],
          "properties": {"kind": {"enum": ["SecretStore", "ClusterSecretStore"]}, "name": {"type": "string", "minLength": 1}}
        }
      }
    },
    "namespaces": {
      "type": "object", "additionalProperties": false, "required": ["application", "data", "monitoring", "dns"],
      "properties": {
        "application": {"type": "string", "minLength": 1}, "data": {"type": "string", "minLength": 1},
        "monitoring": {"type": "string", "minLength": 1}, "dns": {"type": "string", "minLength": 1}
      }
    },
    "dnsPodLabels": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}}
  }
}
