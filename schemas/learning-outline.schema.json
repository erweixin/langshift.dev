{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lites.dev/schemas/learning-outline.schema.json",
  "title": "LearningOutline",
  "description": "用户个性化学习大纲。它决定接下来学什么，后续 content generation 只消费其中的 TaskSpec。",
  "type": "object",
  "required": ["schema_version", "outline_id", "goal", "target_role", "target_stack", "level_band", "duration_days", "daily_minutes", "summary", "stages", "tasks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "outline_id": { "type": "string" },
    "goal": { "type": "string" },
    "target_role": { "type": "string" },
    "target_stack": { "type": "string" },
    "level_band": { "type": "string" },
    "duration_days": { "type": "integer", "minimum": 1, "maximum": 60 },
    "daily_minutes": { "type": "integer", "minimum": 5, "maximum": 240 },
    "summary": { "type": "string" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "goal", "days"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "goal": { "type": "string" },
          "days": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["day_index", "task_template_id", "target_stack", "level_band", "title", "judge", "minutes"],
        "additionalProperties": false,
        "properties": {
          "day_index": { "type": "integer", "minimum": 1 },
          "task_template_id": { "type": "string" },
          "target_stack": { "type": "string" },
          "level_band": { "type": "string" },
          "title": { "type": "string" },
          "judge": { "type": "string" },
          "minutes": { "type": "integer", "minimum": 5, "maximum": 180 }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "model": { "type": "string" },
        "tok_in": { "type": "integer" },
        "tok_out": { "type": "integer" }
      }
    }
  }
}
