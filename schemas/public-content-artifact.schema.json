{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lites.dev/schemas/public-content-artifact.schema.json",
  "title": "PublicContentArtifact",
  "description": "GET /api/content-artifacts/{content_key} 下发给客户端的内容 artifact 投影。它明确剥离 exercise.reference_solution，只保留学习页需要展示和运行的字段。",
  "type": "object",
  "required": [
    "schema_version",
    "content_key",
    "task_template_id",
    "target_stack",
    "level_band",
    "content_version",
    "prompt_version",
    "review_status",
    "validation_attempts",
    "lesson",
    "exercise"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "content_key": { "type": "string" },
    "task_template_id": { "type": "string" },
    "target_stack": { "type": "string" },
    "level_band": { "type": "string" },
    "content_version": { "type": "integer", "minimum": 1 },
    "prompt_version": { "type": "integer", "minimum": 1 },
    "review_status": { "enum": ["auto_ok", "needs_review", "human_ok", "rejected"] },
    "validation_attempts": { "type": "integer", "minimum": 0 },
    "lesson": {
      "type": "object",
      "required": ["title", "minutes", "judge", "sections"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "minutes": { "type": "integer", "minimum": 1 },
        "judge": { "type": "string" },
        "why": { "type": "string" },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "body_md"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "body_md": { "type": "string" },
              "runnable": {
                "type": "object",
                "required": ["kind"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "enum": ["demo", "exercise"] },
                  "demo_code": { "type": "string" }
                }
              }
            }
          }
        },
        "coach_note": { "type": "string" }
      }
    },
    "exercise": {
      "type": "object",
      "required": ["language", "starter_code", "harness_version", "tests"],
      "additionalProperties": false,
      "properties": {
        "language": { "enum": ["javascript", "typescript", "js", "ts"] },
        "starter_code": { "type": "string" },
        "harness_version": { "type": "integer", "minimum": 1 },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "call", "expect", "judge", "label"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "call": { "type": "string" },
              "expect": {},
              "judge": { "type": "boolean" },
              "label": { "type": "string" }
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "model": { "type": "string" },
        "tok_in": { "type": "integer" },
        "tok_out": { "type": "integer" },
        "validation_attempts": { "type": "integer" }
      }
    }
  }
}
