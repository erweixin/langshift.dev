{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lites.dev/schemas/outline-generation-input.schema.json",
  "title": "OutlineGenerationInput",
  "description": "POST /api/outline-generation-runs 的请求体。它允许用户信息和用户要求影响学习大纲，但不直接影响可复用 content_artifacts。",
  "type": "object",
  "required": ["goal", "current_level", "target_role", "target_stack"],
  "additionalProperties": false,
  "properties": {
    "goal": { "type": "string" },
    "current_level": { "type": "string" },
    "target_role": { "type": "string" },
    "target_stack": { "type": "string" },
    "daily_minutes": { "type": "integer", "minimum": 5, "maximum": 240, "default": 30 },
    "duration_days": { "type": "integer", "minimum": 1, "maximum": 60, "default": 14 },
    "preferences": {
      "type": "array",
      "items": { "type": "string" }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "background": { "type": "string" }
  }
}
