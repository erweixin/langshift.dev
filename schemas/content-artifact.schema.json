{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lites.dev/schemas/content-artifact.schema.json",
  "title": "ContentArtifact",
  "description": "课程内容定稿的存储与定稿校验契约（完整版）。两点注意：① 下发客户端的是剥离 exercise.reference_solution 后的投影（见 docs/exercise-runtime.md）；② 生成侧 structured output 使用本 schema 的简化投影（structured outputs 不支持 contains 等关键字），judge 覆盖与「测试必须挂掉起始代码」由管线校验步骤强制（docs/content-pipeline.md 校验 #2/#3），本 schema 在定稿写入前做最终把关。",
  "type": "object",
  "required": ["schema_version", "content_key", "task_template_id", "target_stack", "level_band", "content_version", "prompt_version", "lesson", "exercise"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "content_key": { "type": "string", "description": "hash(task_template_id, target_stack, level_band, content_version, prompt_version)" },
    "task_template_id": { "type": "string", "description": "如 fe2agent-d01，见 docs/curriculum-14d.md" },
    "target_stack": { "type": "string", "description": "参与 content_key 计算，必填" },
    "level_band": { "type": "string" },
    "content_version": { "type": "integer", "minimum": 1 },
    "prompt_version": { "type": "integer", "minimum": 1 },
    "lesson": {
      "type": "object",
      "required": ["title", "minutes", "judge", "sections"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "minutes": { "type": "integer", "minimum": 10, "maximum": 90 },
        "judge": { "type": "string", "description": "判断点文本，来自 TaskSpec" },
        "why": { "type": "string" },
        "sections": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["id", "title", "body_md"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "body_md": { "type": "string" },
              "runnable": {
                "type": "object",
                "description": "该节内嵌的代码块；exercise 类型引用顶层 exercise 字段",
                "required": ["kind"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "enum": ["demo", "exercise"] },
                  "demo_code": { "type": "string" }
                }
              }
            }
          }
        },
        "coach_note": { "type": "string" }
      }
    },
    "exercise": {
      "type": "object",
      "required": ["language", "starter_code", "reference_solution", "harness_version", "tests"],
      "additionalProperties": false,
      "properties": {
        "language": { "enum": ["js", "go", "python"] },
        "starter_code": { "type": "string" },
        "reference_solution": { "type": "string", "description": "校验闭环必需物（定稿前必须真跑通全部测试），存储必填；仅服务端使用，下发投影中剥离" },
        "harness_version": { "type": "integer", "minimum": 1 },
        "tests": {
          "type": "array",
          "minItems": 3,
          "contains": {
            "type": "object",
            "required": ["judge"],
            "properties": { "judge": { "const": true } }
          },
          "items": {
            "type": "object",
            "required": ["id", "call", "expect", "judge", "label"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "call": { "type": "string", "description": "对用户函数的调用表达式" },
              "expect": { "description": "期望值（任意 JSON 类型）" },
              "judge": { "type": "boolean", "description": "是否为判断点测试；全卷至少一条为 true" },
              "label": { "type": "string" }
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "model": { "type": "string" },
        "tok_in": { "type": "integer" },
        "tok_out": { "type": "integer" },
        "validation_attempts": { "type": "integer", "description": "校验重试次数，进质量看板" }
      }
    }
  }
}
