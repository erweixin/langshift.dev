{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lites.dev/schemas/review-output.schema.json",
  "title": "ReviewOutput",
  "description": "Review run 传给模型的 structured output 契约。调用方在写 ReviewCompleted 事件前注入 evidence_id，因此本 schema 不包含 evidence_id。",
  "type": "object",
  "required": ["did", "fix", "next", "cap_delta", "memo", "next_task_seed"],
  "additionalProperties": false,
  "properties": {
    "did": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "「你已经做到」——先肯定，与 UI 的 Review 结果屏一致"
    },
    "fix": { "type": "string", "description": "当前最值得改的一个点（一次只改一个）" },
    "next": { "type": "string", "description": "下一步（只做这一件）" },
    "cap_delta": {
      "type": "object",
      "required": ["capability_id", "from", "to", "label"],
      "additionalProperties": false,
      "properties": {
        "capability_id": { "type": "string", "description": "对应画像 capabilities[].id（docs/learner-profile.md）" },
        "from": { "type": "integer", "minimum": 0, "maximum": 4, "description": "0 未接触 / 1 看过 / 2 能解释 / 3 能实现 / 4 能教" },
        "to": { "type": "integer", "minimum": 0, "maximum": 4, "description": "一次 Review 至多 +1，投影层强制" },
        "label": { "type": "string", "description": "用户可读的变化描述，如「看过 → 能解释」" }
      }
    },
    "misconception": {
      "type": "object",
      "required": ["statement"],
      "additionalProperties": false,
      "properties": {
        "statement": { "type": "string", "description": "误解的一句话表述，如「把 failed 当成了终态可回退」" },
        "planned_probe_hint": { "type": "string", "description": "建议用什么样的任务验证已纠正" }
      },
      "description": "可选：本次发现的活跃误解"
    },
    "memo": { "type": "string", "description": "写给用户的记忆卡条目（完成态「今天我记住了你」展示）" },
    "next_task_seed": {
      "type": "object",
      "required": ["title", "minutes"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "minutes": { "type": "integer", "minimum": 1 }
      },
      "description": "明日任务种子，任务生成 run 消费"
    }
  }
}
