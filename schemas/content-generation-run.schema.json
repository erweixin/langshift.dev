{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lites.dev/schemas/content-generation-run.schema.json",
  "title": "ContentGenerationRun",
  "description": "POST /api/content-generation-runs 与 GET /api/content-generation-runs/{run_id} 的公开 run 投影。",
  "type": "object",
  "required": ["run_id", "status"],
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string" },
    "status": {
      "enum": [
        "accepted",
        "queued",
        "executing",
        "waiting_tool",
        "waiting_approval",
        "succeeded",
        "failed",
        "expired",
        "cancelled"
      ]
    },
    "content_key": { "type": "string" },
    "cache_hit": { "type": "boolean" },
    "error": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
