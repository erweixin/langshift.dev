{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lites.dev/schemas/outline-generation-run.schema.json",
  "title": "OutlineGenerationRun",
  "description": "学习大纲生成 run 的公开投影。",
  "type": "object",
  "required": ["run_id", "status"],
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string" },
    "status": {
      "enum": ["accepted", "queued", "executing", "waiting_tool", "waiting_approval", "succeeded", "failed", "expired", "cancelled"]
    },
    "outline_id": { "type": "string" },
    "error": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
