{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lites.dev/schemas/exercise-result.schema.json",
  "title": "ExerciseResult",
  "description": "练习运行结果，v0 浏览器运行时与 v1 服务端沙箱统一使用；作为 ExerciseRunRecorded 事件的 payload 主体（见 docs/event-catalog.md）。",
  "type": "object",
  "required": ["status", "cases", "judge_hit", "duration_ms", "code_hash", "harness_version"],
  "additionalProperties": false,
  "properties": {
    "status": { "enum": ["ok", "error", "timeout"] },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "pass"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "pass": { "type": "boolean" },
          "actual": { "type": "string", "description": "实际值的字符串表示，便于展示与 Review 引用" },
          "error": { "type": "string" }
        }
      }
    },
    "judge_hit": { "type": "boolean", "description": "所有 judge:true 的测试是否全部通过" },
    "logs": { "type": "array", "items": { "type": "string" }, "description": "console 输出，截断后最多 200 条" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "code_hash": { "type": "string", "description": "用户代码快照 hash，提交与 Review 关联用" },
    "harness_version": { "type": "integer", "minimum": 1 },
    "runtime": { "enum": ["browser-js", "server-sandbox"], "default": "browser-js" }
  }
}
