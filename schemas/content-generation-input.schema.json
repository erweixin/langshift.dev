{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lites.dev/schemas/content-generation-input.schema.json",
  "title": "ContentGenerationInput",
  "description": "POST /api/content-generation-runs 的请求体。它是内容生成调试入口的稳定契约，正式 task-scoped 入口会复用同一组维度。",
  "type": "object",
  "required": ["task_template_id", "target_stack", "level_band", "title", "judge"],
  "additionalProperties": false,
  "properties": {
    "task_id": { "type": "string" },
    "task_template_id": { "type": "string" },
    "target_stack": { "type": "string" },
    "level_band": { "type": "string" },
    "title": { "type": "string" },
    "judge": { "type": "string" },
    "minutes": { "type": "integer", "minimum": 5, "maximum": 180, "default": 30 },
    "context": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
