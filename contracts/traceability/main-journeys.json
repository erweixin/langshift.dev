{
  "contractVersion": "1.0.0",
  "journeys": [
    {
      "id": "JOURNEY-ANONYMOUS-CLAIM",
      "steps": [
        {
          "name": "anonymous onboarding",
          "ui": "/onboarding",
          "api": [
            "onboarding.create"
          ],
          "eventOrState": [
            "AnonymousSubjectCreated"
          ],
          "data": [
            "identity.anonymous_subjects",
            "identity.onboarding_sessions"
          ],
          "step": 1,
          "testId": "JOURNEY-ANONYMOUS-CLAIM-STEP-01"
        },
        {
          "name": "capability confirmation",
          "ui": "/onboarding/capabilities",
          "api": [
            "onboarding.update"
          ],
          "eventOrState": [
            "OnboardingSessionUpdated"
          ],
          "data": [
            "identity.onboarding_sessions"
          ],
          "step": 2,
          "testId": "JOURNEY-ANONYMOUS-CLAIM-STEP-02"
        },
        {
          "name": "route preview",
          "ui": "/onboarding/route",
          "api": [
            "onboarding.route_preview"
          ],
          "eventOrState": [
            "RoutePreviewRequested",
            "RoutePreviewGenerated"
          ],
          "data": [
            "identity.onboarding_sessions",
            "product.route_revisions"
          ],
          "step": 3,
          "testId": "JOURNEY-ANONYMOUS-CLAIM-STEP-03"
        },
        {
          "name": "email registration",
          "ui": "/register",
          "api": [
            "auth.register"
          ],
          "eventOrState": [
            "UserRegistered",
            "EmailVerificationRequested"
          ],
          "data": [
            "identity.users",
            "identity.password_credentials",
            "identity.email_verifications"
          ],
          "step": 4,
          "testId": "JOURNEY-ANONYMOUS-CLAIM-STEP-04"
        },
        {
          "name": "email verification",
          "ui": "/verify-email",
          "api": [
            "auth.verify_email"
          ],
          "eventOrState": [
            "EmailVerified"
          ],
          "data": [
            "identity.email_verifications"
          ],
          "step": 5,
          "testId": "JOURNEY-ANONYMOUS-CLAIM-STEP-05"
        },
        {
          "name": "claim reserve",
          "ui": "/onboarding/save",
          "api": [
            "onboarding.claim"
          ],
          "eventOrState": [
            "AnonymousClaimReserved"
          ],
          "data": [
            "identity.onboarding_claims"
          ],
          "step": 6,
          "testId": "JOURNEY-ANONYMOUS-CLAIM-STEP-06"
        },
        {
          "name": "destination Mission commit",
          "ui": "/missions",
          "api": [
            "onboarding.claim"
          ],
          "eventOrState": [
            "AnonymousClaimDestinationCommitted",
            "MissionCreated"
          ],
          "data": [
            "product.mission_imports",
            "product.missions"
          ],
          "step": 7,
          "testId": "JOURNEY-ANONYMOUS-CLAIM-STEP-07"
        },
        {
          "name": "source erasure receipts",
          "ui": "/onboarding/save",
          "api": [
            "onboarding.claim"
          ],
          "eventOrState": [
            "AnonymousClaimErasureStarted",
            "AnonymousErasureReceiptRecorded"
          ],
          "data": [
            "identity.anonymous_erasure_receipts"
          ],
          "step": 8,
          "testId": "JOURNEY-ANONYMOUS-CLAIM-STEP-08"
        },
        {
          "name": "claimed",
          "ui": "/today",
          "api": [
            "onboarding.claim"
          ],
          "eventOrState": [
            "AnonymousClaimCompleted"
          ],
          "data": [
            "identity.onboarding_claims",
            "product.mission_focuses"
          ],
          "step": 9,
          "testId": "JOURNEY-ANONYMOUS-CLAIM-STEP-09"
        }
      ]
    },
    {
      "id": "JOURNEY-DAILY-LOOP",
      "steps": [
        {
          "name": "focused Mission",
          "ui": "/today",
          "api": [
            "missions.list"
          ],
          "eventOrState": [
            "MissionFocusChanged"
          ],
          "data": [
            "product.mission_focuses"
          ],
          "step": 1,
          "testId": "JOURNEY-DAILY-LOOP-STEP-01"
        },
        {
          "name": "Today task",
          "ui": "/today",
          "api": [
            "tasks.generate"
          ],
          "eventOrState": [
            "DailyTaskScheduled"
          ],
          "data": [
            "product.daily_tasks"
          ],
          "step": 2,
          "testId": "JOURNEY-DAILY-LOOP-STEP-02"
        },
        {
          "name": "Learn",
          "ui": "/tasks/{id}",
          "api": [
            "tasks.list"
          ],
          "eventOrState": [
            "DailyTaskScheduled"
          ],
          "data": [
            "product.daily_tasks",
            "product.content_revisions"
          ],
          "step": 3,
          "testId": "JOURNEY-DAILY-LOOP-STEP-03"
        },
        {
          "name": "Practice",
          "ui": "/tasks/{id}",
          "api": [
            "tasks.update"
          ],
          "eventOrState": [
            "DailyTaskSubmitted"
          ],
          "data": [
            "product.daily_tasks"
          ],
          "step": 4,
          "testId": "JOURNEY-DAILY-LOOP-STEP-04"
        },
        {
          "name": "Submit",
          "ui": "/tasks/{id}/submit",
          "api": [
            "submissions.create"
          ],
          "eventOrState": [
            "SubmissionRecorded"
          ],
          "data": [
            "product.submissions"
          ],
          "step": 5,
          "testId": "JOURNEY-DAILY-LOOP-STEP-05"
        },
        {
          "name": "Review",
          "ui": "/reviews/{id}",
          "api": [
            "reviews.generate"
          ],
          "eventOrState": [
            "ReviewCompleted"
          ],
          "data": [
            "product.reviews"
          ],
          "step": 6,
          "testId": "JOURNEY-DAILY-LOOP-STEP-06"
        },
        {
          "name": "Evidence",
          "ui": "/evidence",
          "api": [
            "evidence.record"
          ],
          "eventOrState": [
            "CapabilityEvidenceRecorded"
          ],
          "data": [
            "product.evidence"
          ],
          "step": 7,
          "testId": "JOURNEY-DAILY-LOOP-STEP-07"
        },
        {
          "name": "next task recalibration",
          "ui": "/today",
          "api": [
            "tasks.generate"
          ],
          "eventOrState": [
            "DailyTaskScheduled"
          ],
          "data": [
            "product.daily_tasks",
            "product.mission_focuses"
          ],
          "step": 8,
          "testId": "JOURNEY-DAILY-LOOP-STEP-08"
        }
      ]
    },
    {
      "id": "JOURNEY-CORRECT-TRANSFER",
      "steps": [
        {
          "name": "open Map",
          "ui": "/map",
          "api": [
            "claims.list"
          ],
          "eventOrState": [
            "CapabilityClaimRevised"
          ],
          "data": [
            "product.capability_claims"
          ],
          "step": 1,
          "testId": "JOURNEY-CORRECT-TRANSFER-STEP-01"
        },
        {
          "name": "record contradicting evidence",
          "ui": "/map/correct",
          "api": [
            "evidence.record"
          ],
          "eventOrState": [
            "CapabilityEvidenceRecorded"
          ],
          "data": [
            "product.evidence"
          ],
          "step": 2,
          "testId": "JOURNEY-CORRECT-TRANSFER-STEP-02"
        },
        {
          "name": "new claim revision",
          "ui": "/map/correct",
          "api": [
            "claims.revise"
          ],
          "eventOrState": [
            "CapabilityClaimRevised"
          ],
          "data": [
            "product.capability_claims",
            "product.claim_evidence_links"
          ],
          "step": 3,
          "testId": "JOURNEY-CORRECT-TRANSFER-STEP-03"
        },
        {
          "name": "accepted route becomes stale",
          "ui": "/map",
          "api": [
            "claims.revise"
          ],
          "eventOrState": [
            "RouteMarkedStale"
          ],
          "data": [
            "product.route_revisions"
          ],
          "step": 4,
          "testId": "JOURNEY-CORRECT-TRANSFER-STEP-04"
        },
        {
          "name": "generate new route",
          "ui": "/route",
          "api": [
            "routes.generate"
          ],
          "eventOrState": [
            "RouteGenerationRequested"
          ],
          "data": [
            "product.route_revisions"
          ],
          "step": 5,
          "testId": "JOURNEY-CORRECT-TRANSFER-STEP-05"
        },
        {
          "name": "review proposed revision",
          "ui": "/route",
          "api": [
            "routes.list"
          ],
          "eventOrState": [
            "RouteProposed"
          ],
          "data": [
            "product.route_revisions"
          ],
          "step": 6,
          "testId": "JOURNEY-CORRECT-TRANSFER-STEP-06"
        },
        {
          "name": "accept revision",
          "ui": "/route",
          "api": [
            "routes.accept"
          ],
          "eventOrState": [
            "RouteAccepted"
          ],
          "data": [
            "product.route_revisions",
            "product.missions"
          ],
          "step": 7,
          "testId": "JOURNEY-CORRECT-TRANSFER-STEP-07"
        }
      ]
    },
    {
      "id": "JOURNEY-CREATE",
      "steps": [
        {
          "name": "create Project from accepted route",
          "ui": "/create/new",
          "api": [
            "projects.create"
          ],
          "eventOrState": [
            "ProjectCreated"
          ],
          "data": [
            "product.projects"
          ],
          "step": 1,
          "testId": "JOURNEY-CREATE-STEP-01"
        },
        {
          "name": "bind Workspace branch",
          "ui": "/create/{id}/workspace",
          "api": [
            "workspace.bind"
          ],
          "eventOrState": [
            "ProjectWorkspaceBound"
          ],
          "data": [
            "product.project_workspace_bindings"
          ],
          "step": 2,
          "testId": "JOURNEY-CREATE-STEP-02"
        },
        {
          "name": "create required Milestones",
          "ui": "/create/{id}/milestones",
          "api": [
            "milestones.create"
          ],
          "eventOrState": [
            "MilestoneCreated"
          ],
          "data": [
            "product.project_milestones"
          ],
          "step": 3,
          "testId": "JOURNEY-CREATE-STEP-03"
        },
        {
          "name": "complete first required Milestone",
          "ui": "/create/{id}/milestones/{mid}",
          "api": [
            "milestones.update"
          ],
          "eventOrState": [
            "MilestoneStatusChanged"
          ],
          "data": [
            "product.project_milestones"
          ],
          "step": 4,
          "testId": "JOURNEY-CREATE-STEP-04"
        },
        {
          "name": "complete second required Milestone",
          "ui": "/create/{id}/milestones/{mid}",
          "api": [
            "milestones.update"
          ],
          "eventOrState": [
            "MilestoneStatusChanged"
          ],
          "data": [
            "product.project_milestones"
          ],
          "step": 5,
          "testId": "JOURNEY-CREATE-STEP-05"
        },
        {
          "name": "test or rubric verification",
          "ui": "/create/{id}/tests",
          "api": [
            "projects.test"
          ],
          "eventOrState": [
            "ProjectTestRunRecorded"
          ],
          "data": [
            "product.project_test_runs"
          ],
          "step": 6,
          "testId": "JOURNEY-CREATE-STEP-06"
        },
        {
          "name": "record Evidence",
          "ui": "/evidence",
          "api": [
            "evidence.record"
          ],
          "eventOrState": [
            "CapabilityEvidenceRecorded"
          ],
          "data": [
            "product.evidence"
          ],
          "step": 7,
          "testId": "JOURNEY-CREATE-STEP-07"
        },
        {
          "name": "create Artifact revision",
          "ui": "/create/{id}/artifact",
          "api": [
            "artifacts.create",
            "artifacts.revise"
          ],
          "eventOrState": [
            "ArtifactCreated",
            "ArtifactRevisionCreated"
          ],
          "data": [
            "product.artifacts",
            "product.artifact_revisions"
          ],
          "step": 8,
          "testId": "JOURNEY-CREATE-STEP-08"
        },
        {
          "name": "record reflection and complete",
          "ui": "/create/{id}/complete",
          "api": [
            "projects.complete"
          ],
          "eventOrState": [
            "ProjectReflectionRecorded",
            "ProjectStatusChanged"
          ],
          "data": [
            "product.projects"
          ],
          "step": 9,
          "testId": "JOURNEY-CREATE-STEP-09"
        },
        {
          "name": "exact-manifest portfolio export",
          "ui": "/create/{id}/export",
          "api": [
            "portfolio.export"
          ],
          "eventOrState": [
            "PortfolioExportRequested",
            "PortfolioExportCompleted"
          ],
          "data": [
            "product.portfolio_exports"
          ],
          "step": 10,
          "testId": "JOURNEY-CREATE-STEP-10"
        }
      ]
    },
    {
      "id": "JOURNEY-ENTERPRISE-SHARE",
      "steps": [
        {
          "name": "private content denied",
          "ui": "/enterprise/review",
          "api": [
            "evidence.list"
          ],
          "eventOrState": [
            "ShareGrantRevoked"
          ],
          "data": [
            "product.share_grants"
          ],
          "step": 1,
          "testId": "JOURNEY-ENTERPRISE-SHARE-STEP-01"
        },
        {
          "name": "user creates scoped share grant",
          "ui": "/evidence/share",
          "api": [
            "share_grants.create"
          ],
          "eventOrState": [
            "ShareGrantCreated"
          ],
          "data": [
            "product.share_grants"
          ],
          "step": 2,
          "testId": "JOURNEY-ENTERPRISE-SHARE-STEP-02"
        },
        {
          "name": "reviewer reads only granted revision",
          "ui": "/enterprise/review",
          "api": [
            "evidence.list"
          ],
          "eventOrState": [
            "ShareGrantCreated"
          ],
          "data": [
            "product.share_grants",
            "product.evidence"
          ],
          "step": 3,
          "testId": "JOURNEY-ENTERPRISE-SHARE-STEP-03"
        },
        {
          "name": "user revokes grant",
          "ui": "/evidence/share",
          "api": [
            "share_grants.revoke"
          ],
          "eventOrState": [
            "ShareGrantRevoked"
          ],
          "data": [
            "product.share_grants"
          ],
          "step": 4,
          "testId": "JOURNEY-ENTERPRISE-SHARE-STEP-04"
        },
        {
          "name": "new reads denied",
          "ui": "/enterprise/review",
          "api": [
            "evidence.list"
          ],
          "eventOrState": [
            "ShareGrantRevoked"
          ],
          "data": [
            "product.share_grants"
          ],
          "step": 5,
          "testId": "JOURNEY-ENTERPRISE-SHARE-STEP-05"
        },
        {
          "name": "audit remains",
          "ui": "/admin/audit",
          "api": [
            "admin.audit.list"
          ],
          "eventOrState": [
            "ShareGrantRevoked"
          ],
          "data": [
            "product.share_grants",
            "identity.security_events"
          ],
          "step": 6,
          "testId": "JOURNEY-ENTERPRISE-SHARE-STEP-06"
        }
      ]
    }
  ]
}
