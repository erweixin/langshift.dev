  "operationOverrides": {
    "onboarding.update": {
      "status": "implemented",
      "plannedStage": 1,
      "reason": "Identity Service implements authenticated or anonymous-subject-scoped partial intake updates with strict validation, idempotent replay, CAS, encrypted payload replacement and an OnboardingSessionUpdated event/outbox."
    },
    "auth.resend_verification": {
      "status": "implemented",
      "plannedStage": 1,
      "reason": "Identity Service implements enumeration-safe idempotent resend with token rotation, event/outbox and mail delivery tests."
    },
    "auth.session.switch_tenant": {
      "status": "implemented",
      "plannedStage": 1,
      "reason": "Identity Service implements membership authorization, session CAS, stable idempotent replay, security audit and SessionActiveTenantChanged event/outbox."
    },
    "account.get": {
      "status": "implemented",
      "plannedStage": 1,
      "reason": "Identity Service exposes the authenticated account projection with email verification state, locale, IANA timezone, display name, CAS version and no-store semantics."
    },
    "account.update": {
      "status": "implemented",
      "plannedStage": 1,
      "reason": "Identity Service implements validated locale, timezone and nullable display-name updates with idempotency, CAS, audit and AccountProfileUpdated event/outbox."
    },
    "tenants.list": {
      "status": "implemented",
      "plannedStage": 1,
      "reason": "Identity Service provides an authenticated, security-definer-backed and signed-cursor tenant membership list with active-tenant context and audit logging."
    },
