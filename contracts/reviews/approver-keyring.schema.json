{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://lites.dev/schemas/contract-approver-keyring.json",
  "type":"object",
  "additionalProperties":false,
  "required":["keyringVersion","keys"],
  "properties":{
    "keyringVersion":{"const":"1.0.0"},
    "keys":{
      "type":"array",
      "minItems":5,
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["keyId","approverId","reviewRoles","publicKeyPem","status","registeredAt"],
        "properties":{
          "keyId":{"type":"string","minLength":1},
          "approverId":{"type":"string","minLength":1},
          "reviewRoles":{"type":"array","minItems":1,"items":{"enum":["product","frontend","backend","security","qa"]}},
          "publicKeyPem":{"type":"string","pattern":"^-----BEGIN PUBLIC KEY-----"},
          "status":{"enum":["active","revoked"]},
          "registeredAt":{"type":"string","format":"date-time"},
          "revokedAt":{"type":["string","null"],"format":"date-time"}
        }
      }
    }
  }
}
