{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://lites.dev/schemas/contract-approval-record.json",
  "type":"object",
  "additionalProperties":false,
  "required":["snapshotId","contentRootSha256","reviewRole","approverId","activeRole","reviewEvidenceHash","decision","decidedAt","signature"],
  "properties":{
    "snapshotId":{"type":"string","pattern":"^contract-[a-f0-9]{20}$"},
    "contentRootSha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "reviewRole":{"enum":["product","frontend","backend","security","qa"]},
    "approverId":{"type":"string","minLength":1},
    "activeRole":{"type":"string","minLength":1},
    "reviewEvidenceHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "decision":{"enum":["approved","rejected"]},
    "decidedAt":{"type":"string","format":"date-time"},
    "signature":{
      "type":"object",
      "additionalProperties":false,
      "required":["kind","keyId","value"],
      "properties":{
        "kind":{"enum":["sigstore","gpg","platform_approval_event"]},
        "keyId":{"type":"string","minLength":1},
        "value":{"type":"string","minLength":16}
      }
    }
  }
}
