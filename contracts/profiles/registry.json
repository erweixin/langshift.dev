                    "evidenceId",
                    "claimId",
                    "reason"
                  ],
                  "properties": {
                    "evidenceId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "claimId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requirement",
              "reason",
              "citations"
            ],
            "properties": {
              "requirement": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "citations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "evidenceId",
                    "claimId",
                    "reason"
                  ],
                  "properties": {
                    "evidenceId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "claimId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "outcome",
              "taskTemplateIds"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "type": "string",
                "minLength": 1
              },
              "taskTemplateIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "firstTask": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "gap",
            "estimatedMinutes",
            "successCriteria"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "gap": {
              "type": "string",
              "minLength": 1
            },
