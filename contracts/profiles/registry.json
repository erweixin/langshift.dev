            "version",
            "dimensions"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            },
            "dimensions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "profile-output-evaluator": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "profile-output-evaluator",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministicDecision",
        "rubricScores",
        "feedback",
        "uncertainty",
        "evidenceProposal",
        "capabilityUpgrade"
      ],
      "properties": {
        "deterministicDecision": {
          "enum": [
            "pass",
            "rework",
            "cannot_determine"
          ]
        },
        "rubricScores": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dimension",
              "score",
              "reason",
              "citations"
            ],
            "properties": {
              "dimension": {
                "type": "string",
                "minLength": 1
              },
              "score": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "citations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "feedback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primaryIssue",
            "nextAction"
          ],
          "properties": {
            "primaryIssue": {
              "type": "string",
              "minLength": 1
            },
            "nextAction": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "uncertainty": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "reason"
          ],
          "properties": {
            "level": {
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "evidenceProposal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eligible",
            "evidenceType",
            "sourceRevision"
          ],
          "properties": {
            "eligible": {
              "type": "boolean"
            },
            "evidenceType": {
              "type": [
                "string",
                "null"
              ]
            },
            "sourceRevision": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "capabilityUpgrade": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "performed",
            "requiresSeparatePolicyDecision"
          ],
          "properties": {
            "performed": {
              "const": false
            },
            "requiresSeparatePolicyDecision": {
              "const": true
            }
          }
        }
      }
    },
    "profile-input-artifact-builder": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "profile-input-artifact-builder",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission",
        "claims",
        "evidence",
        "locale",
        "semanticKey",
        "project",
        "workspaceRevision",
        "artifactRevisions",
        "evidenceManifest",
        "externalDestination",
        "approval"
      ],
      "properties": {
        "mission": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "sourceRole",
            "targetRole",
            "focusVersion"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "sourceRole": {
              "type": "string",
              "minLength": 1
            },
            "targetRole": {
              "type": "string",
              "minLength": 1
            },
            "focusVersion": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "capability",
              "status",
              "verificationLevel",
              "revision",
              "evidenceIds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "capability": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "active",
                  "disputed",
                  "superseded",
                  "withdrawn",
                  "rejected"
                ]
              },
              "verificationLevel": {
                "enum": [
                  "inferred",
                  "user_confirmed",
                  "demonstrated",
                  "applied",
                  "reviewer_verified"
                ]
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "statement",
              "contentHash"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "recorded",
                  "verified",
                  "disputed",
                  "invalidated"
                ]
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "contentHash": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "locale": {
          "enum": [
            "en",
            "zh-CN"
          ]
        },
        "semanticKey": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "status",
            "requiredMilestones",
            "completedMilestones",
            "reflectionRecorded"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "draft",
                "active",
                "blocked",
                "completed",
                "archived"
              ]
            },
            "requiredMilestones": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "completedMilestones": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "reflectionRecorded": {
              "type": "boolean"
            }
          }
        },
        "workspaceRevision": {
          "type": "string",
          "minLength": 1
        },
        "artifactRevisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceManifest": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "externalDestination": {
          "type": [
            "string",
            "null"
          ]
        },
        "approval": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "scopeHash": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "profile-output-artifact-builder": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "profile-output-artifact-builder",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "completionAllowed",
        "artifact",
        "revisionManifest",
        "scan",
        "externalWrite"
      ],
      "properties": {
        "status": {
          "enum": [
            "built",
            "incomplete",
            "quarantined",
            "approval_required",
            "failed"
          ]
        },
        "completionAllowed": {
          "type": "boolean"
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "contentRef",
            "contentHash"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "contentRef": {
              "type": "string",
              "minLength": 1
            },
            "contentHash": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "revisionManifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projectId",
            "workspaceRevision",
            "artifactRevisions",
            "evidenceIds",
            "manifestHash"
          ],
          "properties": {
            "projectId": {
              "type": "string",
              "minLength": 1
            },
            "workspaceRevision": {
              "type": "string",
              "minLength": 1
            },
            "artifactRevisions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "evidenceIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "manifestHash": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "scan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "findings"
          ],
          "properties": {
            "status": {
              "enum": [
                "clean",
                "quarantined",
                "failed"
              ]
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "externalWrite": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requested",
            "approved",
            "performed",
            "proposalHash"
          ],
          "properties": {
            "requested": {
              "type": "boolean"
            },
            "approved": {
              "type": "boolean"
            },
            "performed": {
              "type": "boolean"
            },
            "proposalHash": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    }
  }
}
