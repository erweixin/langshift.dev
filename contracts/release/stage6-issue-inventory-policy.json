{
  "policyVersion": "1.0.0",
  "repository": "erweixin/langshift.dev",
  "provider": "github-rest",
  "maximumSnapshotAgeHours": 24,
  "severityLabels": {
    "P0": "severity:P0",
    "P1": "severity:P1",
    "P2": "severity:P2",
    "P3": "severity:P3"
  },
  "openIssueRule": "Every open issue must have exactly one configured severity label; P0 and P1 block GA.",
  "pullRequestsExcluded": true
}
