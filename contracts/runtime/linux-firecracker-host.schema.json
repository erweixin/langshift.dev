{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lites.dev/contracts/runtime/linux-firecracker-host.schema.json",
  "title": "Lites Linux Firecracker runtime host contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "host",
    "firecracker",
    "service",
    "security",
    "artifacts",
    "macosVerification",
    "evidence"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "linux-firecracker-runtime-host-contract" },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operatingSystem", "dedicatedNode", "virtualizationDevice", "cgroupVersion", "initSystem", "pinnedNetworkNamespace"],
      "properties": {
        "operatingSystem": { "const": "linux" },
        "dedicatedNode": { "const": true },
        "virtualizationDevice": { "const": "/dev/kvm" },
        "cgroupVersion": { "const": 2 },
        "initSystem": { "const": "systemd" },
        "pinnedNetworkNamespace": { "const": true }
      }
    },
    "firecracker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "jailerRequired", "immutableRootOwnedAssets", "requiredDigestVariables"],
      "properties": {
        "version": { "const": "1.15.1" },
        "jailerRequired": { "const": true },
        "immutableRootOwnedAssets": { "const": true },
        "requiredDigestVariables": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runAs", "delegateCgroups", "killMode", "preflightRequired", "restartRecoveryFailClosed"],
      "properties": {
        "runAs": { "const": "root" },
        "delegateCgroups": { "const": true },
        "killMode": { "const": "process" },
        "preflightRequired": { "const": true },
        "restartRecoveryFailClosed": { "const": true }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mtlsRequired", "clientSpiffeBindingRequired", "fileBackedSecretsRequired", "assetDigestVerificationRequired", "defaultDenyDevicePolicy"],
      "properties": {
        "mtlsRequired": { "const": true },
        "clientSpiffeBindingRequired": { "const": true },
        "fileBackedSecretsRequired": { "const": true },
        "assetDigestVerificationRequired": { "const": true },
        "defaultDenyDevicePolicy": { "const": true }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readme", "environmentExample", "systemdUnit", "preflight", "entrypoint", "configuration", "adapter"],
      "properties": {
        "readme": { "const": "deploy/runtime-host/README.md" },
        "environmentExample": { "const": "deploy/runtime-host/runtime-host-agent.env.example" },
        "systemdUnit": { "const": "deploy/runtime-host/lites-runtime-host-agent.service" },
        "preflight": { "const": "deploy/runtime-host/runtime-host-preflight.sh" },
        "entrypoint": { "const": "cmd/runtime-host-agent/main.go" },
        "configuration": { "const": "cmd/runtime-host-agent/config.go" },
        "adapter": { "const": "internal/runtime/firecracker/jailer.go" }
      }
    },
    "macosVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["launchesFirecracker", "requiresKvm", "allowedResult"],
      "properties": {
        "launchesFirecracker": { "const": false },
        "requiresKvm": { "const": false },
        "allowedResult": { "const": "fixture_validated" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "productionClaims", "linuxExecutionObserved", "isolationStrengthMeasured"],
      "properties": {
        "classification": { "const": "fixture_validated" },
        "productionClaims": { "const": false },
        "linuxExecutionObserved": { "const": false },
        "isolationStrengthMeasured": { "const": false }
      }
    }
  }
}
