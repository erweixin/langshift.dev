{
  "schemaVersion": "1.0.0",
  "kind": "linux-firecracker-runtime-host-contract",
  "host": {
    "operatingSystem": "linux",
    "dedicatedNode": true,
    "virtualizationDevice": "/dev/kvm",
    "cgroupVersion": 2,
    "initSystem": "systemd",
    "pinnedNetworkNamespace": true
  },
  "firecracker": {
    "version": "1.15.1",
    "jailerRequired": true,
    "immutableRootOwnedAssets": true,
    "requiredDigestVariables": [
      "JAILER_DIGEST",
      "FIRECRACKER_BINARY_DIGEST",
      "FIRECRACKER_KERNEL_DIGEST",
      "FIRECRACKER_ROOTFS_DIGEST",
      "RUNTIME_SCRATCH_DIGEST"
    ]
  },
  "service": {
    "runAs": "root",
    "delegateCgroups": true,
    "killMode": "process",
    "preflightRequired": true,
    "restartRecoveryFailClosed": true
  },
  "security": {
    "mtlsRequired": true,
    "clientSpiffeBindingRequired": true,
    "fileBackedSecretsRequired": true,
    "assetDigestVerificationRequired": true,
    "defaultDenyDevicePolicy": true
  },
  "artifacts": {
    "readme": "deploy/runtime-host/README.md",
    "environmentExample": "deploy/runtime-host/runtime-host-agent.env.example",
    "systemdUnit": "deploy/runtime-host/lites-runtime-host-agent.service",
    "preflight": "deploy/runtime-host/runtime-host-preflight.sh",
    "entrypoint": "cmd/runtime-host-agent/main.go",
    "configuration": "cmd/runtime-host-agent/config.go",
    "adapter": "internal/runtime/firecracker/jailer.go"
  },
  "macosVerification": {
    "launchesFirecracker": false,
    "requiresKvm": false,
    "allowedResult": "fixture_validated"
  },
  "evidence": {
    "classification": "fixture_validated",
    "productionClaims": false,
    "linuxExecutionObserved": false,
    "isolationStrengthMeasured": false
  }
}
