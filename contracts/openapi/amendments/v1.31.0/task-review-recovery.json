{
  "amendmentVersion": "1.31.0",
  "baseContractVersion": "1.30.0",
  "kind": "openapi-schema-version-extension",
  "compatibility": "versioned-client-additive",
  "schemas": {
    "ReviewRecoverySnapshotV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submission_id",
        "submission_revision",
        "generation_id",
        "run_id",
        "rubric_version_id",
        "generation_status",
        "review_id",
        "evidence_id",
        "failure_reason",
        "generation_created_at",
        "generation_updated_at",
        "generation_completed_at"
      ],
      "properties": {
        "submission_id": {"type": "string", "format": "uuid"},
        "submission_revision": {"type": "integer", "minimum": 1},
        "generation_id": {"type": ["string", "null"], "format": "uuid"},
        "run_id": {"type": ["string", "null"], "format": "uuid"},
        "rubric_version_id": {"type": ["string", "null"], "format": "uuid"},
        "generation_status": {"type": ["string", "null"], "enum": ["generating", "succeeded", "failed", "superseded", null]},
        "review_id": {"type": ["string", "null"], "format": "uuid"},
        "evidence_id": {"type": ["string", "null"], "format": "uuid"},
        "failure_reason": {"type": ["string", "null"], "maxLength": 128},
        "generation_created_at": {"type": ["string", "null"], "format": "date-time"},
        "generation_updated_at": {"type": ["string", "null"], "format": "date-time"},
        "generation_completed_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "description": "Owner-scoped durable continuation state. Null when a submitted task has not yet admitted an evaluator generation; submitted plaintext is never returned."
    },
    "DailyTaskResourceV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "mission_id", "route_revision_id", "status", "practice_kind", "task", "estimated_minutes", "difficulty", "focus_version", "scheduled_for", "rescheduled_to", "current_submission_id", "current_review_id", "review_recovery", "completed_at", "created_at", "updated_at"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "version": {"type": "integer", "minimum": 1},
        "mission_id": {"type": "string", "format": "uuid"},
        "route_revision_id": {"type": "string", "format": "uuid"},
        "status": {"enum": ["scheduled", "in_progress", "submitted", "reviewing", "completed", "skipped", "rescheduled"]},
        "practice_kind": {"enum": ["code", "writing", "design"]},
        "task": {"type": "object"},
        "estimated_minutes": {"type": "integer", "minimum": 5, "maximum": 480},
        "difficulty": {"enum": ["easier", "standard", "harder"]},
        "focus_version": {"type": "integer", "minimum": 1},
        "scheduled_for": {"type": "string", "format": "date"},
        "rescheduled_to": {"type": ["string", "null"], "format": "date"},
        "current_submission_id": {"type": ["string", "null"], "format": "uuid"},
        "current_review_id": {"type": ["string", "null"], "format": "uuid"},
        "review_recovery": {"oneOf": [{"$ref": "#/schemas/ReviewRecoverySnapshotV2"}, {"type": "null"}]},
        "completed_at": {"type": ["string", "null"], "format": "date-time"},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "DailyTaskUpdateRequestV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "action", "expected_task_version", "reschedule_for"],
      "properties": {
        "request_id": {"type": "string", "minLength": 8, "maxLength": 256},
        "action": {"enum": ["start", "skip", "reschedule", "lower_difficulty"]},
        "expected_task_version": {"type": "integer", "minimum": 1},
        "reschedule_for": {"anyOf": [{"const": ""}, {"type": "string", "format": "date"}]}
      }
    }
  }
}
