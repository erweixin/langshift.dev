{
  "amendmentVersion": "1.27.0",
  "baseContractVersion": "1.26.0",
  "kind": "openapi-operation-version-extension",
  "compatibility": "versioned-client-additive",
  "operations": {
    "public.status.get.v1": {
      "method": "GET",
      "path": "/v1/public/status",
      "authentication": "gateway_signed_public_request",
      "authorization": "public_exact_route",
      "responseContentType": "application/vnd.lites.public-status.v1+json",
      "responseSchema": "PublicStatusV1",
      "failureMode": "503_status_snapshot_unavailable",
      "cacheControl": "public, max-age=15, must-revalidate"
    }
  },
  "schemas": {
    "PublicStatusComponentV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "state"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_-]{1,64}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "state": {"enum": ["operational", "degraded", "major_outage", "maintenance", "unknown"]},
        "message": {"type": "string", "maxLength": 500}
      }
    },
    "PublicStatusIncidentV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "state", "started_at", "updated_at", "message"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_-]{1,100}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "state": {"enum": ["investigating", "identified", "monitoring", "resolved"]},
        "started_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "message": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "PublicStatusV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "overall", "generated_at", "valid_until", "components", "incidents"],
      "properties": {
        "schema_version": {"const": 1},
        "overall": {"enum": ["operational", "degraded", "major_outage", "maintenance", "unknown"]},
        "generated_at": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"},
        "components": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/schemas/PublicStatusComponentV1"}},
        "incidents": {"type": "array", "maxItems": 100, "items": {"$ref": "#/schemas/PublicStatusIncidentV1"}}
      }
    }
  },
  "integrity": "The service verifies a purpose-specific Ed25519 signature over canonical Go JSON, enforces key issuance windows, exact worst-state aggregation, and a 30-second to 5-minute validity window.",
  "availability": "Missing, malformed, tampered, inconsistent, future, or expired snapshots fail closed with 503; clients must render unknown and never infer operational."
}
