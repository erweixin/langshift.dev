{
  "amendmentVersion": "1.22.0",
  "baseContractVersion": "1.21.0",
  "kind": "openapi-operation-version-extension",
  "compatibility": "versioned-client-additive",
  "operations": {
    "share-grants.create.v2": {
      "method": "POST",
      "path": "/v1/share-grants",
      "authentication": "gateway_signed_session",
      "authorization": "tenant_user_owner_scope",
      "csrf": "required",
      "idempotency": "required_encrypted_durable_response",
      "requestContentType": "application/vnd.lites.share-grant-create.v2+json",
      "requestSchema": "ShareGrantCreateRequestV2",
      "responseContentType": "application/vnd.lites.share-grant.v2+json",
      "responseSchema": "ShareGrantResourceV2",
      "concurrency": "Request deduplication and one live grant per exact owner, grantee, resource and revision.",
      "safety": "Both principals must be active members of the same tenant. The resource must belong to the caller at the supplied exact revision. Private content remains inaccessible without this grant."
    },
    "share-grants.revoke.v2": {
      "method": "DELETE",
      "path": "/v1/share-grants/{grant_id}",
      "authentication": "gateway_signed_session",
      "authorization": "tenant_user_owner_scope",
      "csrf": "required",
      "idempotency": "required_encrypted_durable_response",
      "requestContentType": "application/vnd.lites.share-grant-revoke.v2+json",
      "requestSchema": "ShareGrantRevokeRequestV2",
      "responseContentType": "application/vnd.lites.share-grant.v2+json",
      "responseSchema": "ShareGrantResourceV2",
      "concurrency": "If-Match must equal expected_grant_version. Revocation advances exactly one version and is irreversible.",
      "safety": "After the revocation transaction commits, every new authorization request for the grant is denied immediately."
    },
    "admin.aggregate-queries.query.v2": {
      "method": "POST",
      "path": "/v1/admin/aggregate-queries",
      "authentication": "gateway_signed_session",
      "authorization": "active_owner_admin_or_program_manager",
      "csrf": "required",
      "idempotency": "required_encrypted_durable_response",
      "requestContentType": "application/vnd.lites.aggregate-query-request.v2+json",
      "requestSchema": "AggregateQueryRequestV2",
      "responseContentType": "application/vnd.lites.aggregate-query.v2+json",
      "responseSchema": "AggregateQueryResourceV2",
      "concurrency": "Tenant and snapshot budget is locked and consumed atomically. Replaying the same idempotency key does not consume budget twice.",
      "safety": "Only immutable precomputed cells, one allowlisted dimension, a fixed metric and a coarse time bucket are accepted. Cell and complement sizes below five are stably suppressed; the tenant receives at most 100 consumed queries per snapshot."
    },
    "admin.programs.create.v2": {
      "method": "POST",
      "path": "/v1/admin/programs",
      "authentication": "gateway_signed_session",
      "authorization": "active_enterprise_owner_admin_or_program_manager",
      "csrf": "required",
      "idempotency": "required_encrypted_durable_response",
      "requestContentType": "application/vnd.lites.program-create.v2+json",
      "requestSchema": "ProgramCreateRequestV2",
      "responseContentType": "application/vnd.lites.enterprise-resource.v2+json",
      "responseSchema": "EnterpriseResourceV2",
      "concurrency": "A deterministic program identifier and durable idempotency record make replay side-effect free.",
      "safety": "Only an active enterprise tenant membership can create a program; the owner is pinned to that membership."
    },
    "admin.programs.update.v2": {
      "method": "PATCH",
      "path": "/v1/admin/programs/{program_id}",
      "authentication": "gateway_signed_session",
      "authorization": "active_enterprise_owner_admin_or_program_manager",
      "csrf": "required",
      "idempotency": "required_encrypted_durable_response",
      "requestContentType": "application/vnd.lites.program-update.v2+json",
      "requestSchema": "ProgramUpdateRequestV2",
      "responseContentType": "application/vnd.lites.enterprise-resource.v2+json",
      "responseSchema": "EnterpriseResourceV2",
      "concurrency": "If-Match must equal expected_program_version and the mutation advances exactly one version.",
      "safety": "Archived programs are immutable and every update remains inside the authenticated enterprise tenant."
    },
    "admin.cohorts.create.v2": {
      "method": "POST",
      "path": "/v1/admin/cohorts",
      "authentication": "gateway_signed_session",
      "authorization": "active_enterprise_owner_admin_or_program_manager",
      "csrf": "required",
      "idempotency": "required_encrypted_durable_response",
      "requestContentType": "application/vnd.lites.cohort-create.v2+json",
      "requestSchema": "CohortCreateRequestV2",
      "responseContentType": "application/vnd.lites.enterprise-resource.v2+json",
      "responseSchema": "EnterpriseResourceV2",
      "concurrency": "A deterministic cohort identifier and durable idempotency record make replay side-effect free.",
      "safety": "The referenced program must be active and belong to the same enterprise tenant."
    },
    "admin.cohorts.enroll.v2": {
      "method": "POST",
      "path": "/v1/admin/cohorts/{cohort_id}/enrollments",
      "authentication": "gateway_signed_session",
      "authorization": "active_enterprise_owner_admin_or_program_manager",
      "csrf": "required",
      "idempotency": "required_encrypted_durable_response",
      "requestContentType": "application/vnd.lites.cohort-enroll.v2+json",
      "requestSchema": "CohortEnrollRequestV2",
      "responseContentType": "application/vnd.lites.enterprise-resource.v2+json",
      "responseSchema": "EnterpriseResourceV2",
      "concurrency": "If-Match must equal expected_cohort_version; the cohort enrollment fence advances once for the whole batch.",
      "safety": "Every target must be an active member of the same tenant; exited enrollment history cannot be overwritten or reactivated."
    },
    "admin.cohorts.unenroll.v2": {
      "method": "DELETE",
      "path": "/v1/admin/cohorts/{cohort_id}/enrollments/{user_id}",
      "authentication": "gateway_signed_session",
      "authorization": "active_enterprise_owner_admin_or_program_manager",
      "csrf": "required",
      "idempotency": "required_encrypted_durable_response",
      "requestContentType": "application/vnd.lites.cohort-unenroll.v2+json",
      "requestSchema": "CohortUnenrollRequestV2",
      "responseContentType": "application/vnd.lites.enterprise-resource.v2+json",
      "responseSchema": "EnterpriseResourceV2",
      "concurrency": "If-Match must equal expected_cohort_version; the enrollment and cohort fence advance atomically.",
      "safety": "Leaving is an append-preserving irreversible transition; deletion and reactivation are forbidden."
    },
    "admin.role-packs.publish.v2": {
      "method": "POST",
      "path": "/v1/admin/role-packs",
      "authentication": "gateway_signed_session",
      "authorization": "active_enterprise_owner_admin_or_program_manager",
      "csrf": "required",
      "idempotency": "required_encrypted_durable_response",
      "requestContentType": "application/vnd.lites.role-pack-publish.v2+json",
      "requestSchema": "RolePackPublishRequestV2",
      "responseContentType": "application/vnd.lites.enterprise-resource.v2+json",
      "responseSchema": "EnterpriseResourceV2",
      "concurrency": "Program and revision identify one immutable role pack; duplicate publication conflicts without overwriting history.",
      "safety": "Every role profile and task template must be active in the same tenant and published role packs are append-only."
    }
  },
  "schemas": {
    "ShareGrantCreateRequestV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "grantee_user_id", "resource_kind", "resource_id", "resource_revision", "scope", "expires_at"],
      "properties": {
        "request_id": {"type": "string", "minLength": 8, "maxLength": 256},
        "grantee_user_id": {"type": "string", "format": "uuid"},
        "resource_kind": {"enum": ["evidence", "workspace", "artifact", "project"]},
        "resource_id": {"type": "string", "format": "uuid"},
        "resource_revision": {"type": "string", "minLength": 1, "maxLength": 500},
        "scope": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["read", "review"]}},
        "expires_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "ShareGrantRevokeRequestV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "reason", "expected_grant_version"],
      "properties": {
        "request_id": {"type": "string", "minLength": 8, "maxLength": 256},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
        "expected_grant_version": {"type": "integer", "minimum": 1}
      }
    },
    "ShareGrantResourceV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "status", "updated_at"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "version": {"type": "integer", "minimum": 1},
        "status": {"enum": ["active", "revoked"]},
        "updated_at": {"type": "string", "format": "date-time"},
        "replayed": {"type": "boolean"}
      }
    },
    "AggregateQueryRequestV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "snapshot_id", "metric_key", "dimensions", "time_bucket"],
      "properties": {
        "request_id": {"type": "string", "minLength": 8, "maxLength": 256},
        "snapshot_id": {"type": "string", "format": "uuid"},
        "metric_key": {"enum": ["active_members", "task_completion_rate", "weekly_loop_completion_rate", "project_completion_rate", "aggregate_credit_usage"]},
        "dimensions": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "propertyNames": {"enum": ["program", "cohort", "role_pack", "locale", "coarse_week"]},
          "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "time_bucket": {"enum": ["week", "month", "quarter"]}
      }
    },
    "AggregateQueryResourceV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "status", "updated_at", "snapshot_id", "metric_key", "value", "suppression_reason", "budget_remaining"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "version": {"type": "integer", "minimum": 1},
        "status": {"enum": ["returned", "suppressed"]},
        "updated_at": {"type": "string", "format": "date-time"},
        "snapshot_id": {"type": "string", "format": "uuid"},
        "metric_key": {"enum": ["active_members", "task_completion_rate", "weekly_loop_completion_rate", "project_completion_rate", "aggregate_credit_usage"]},
        "value": {"type": ["number", "null"]},
        "suppression_reason": {"type": ["string", "null"], "enum": [null, "minimum_cell_size", "minimum_complement_size"]},
        "budget_remaining": {"type": "integer", "minimum": 0, "maximum": 99},
        "replayed": {"type": "boolean"}
      }
    },
    "ProgramCreateRequestV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "name", "settings"],
      "properties": {
        "request_id": {"type": "string", "minLength": 8, "maxLength": 256},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "settings": {"type": "object", "additionalProperties": true, "maxProperties": 100}
      }
    },
    "ProgramUpdateRequestV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "name", "status", "settings", "expected_program_version"],
      "properties": {
        "request_id": {"type": "string", "minLength": 8, "maxLength": 256},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "status": {"enum": ["active", "paused", "archived"]},
        "settings": {"type": "object", "additionalProperties": true, "maxProperties": 100},
        "expected_program_version": {"type": "integer", "minimum": 1}
      }
    },
    "CohortCreateRequestV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "program_id", "name"],
      "properties": {
        "request_id": {"type": "string", "minLength": 8, "maxLength": 256},
        "program_id": {"type": "string", "format": "uuid"},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "starts_at": {"type": ["string", "null"], "format": "date-time"},
        "ends_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "CohortEnrollRequestV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "user_ids", "expected_cohort_version"],
      "properties": {
        "request_id": {"type": "string", "minLength": 8, "maxLength": 256},
        "user_ids": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
        "expected_cohort_version": {"type": "integer", "minimum": 1}
      }
    },
    "CohortUnenrollRequestV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "reason", "expected_cohort_version"],
      "properties": {
        "request_id": {"type": "string", "minLength": 8, "maxLength": 256},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
        "expected_cohort_version": {"type": "integer", "minimum": 1}
      }
    },
    "RolePackPublishRequestV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "program_id", "revision", "role_profile_ids", "task_template_ids"],
      "properties": {
        "request_id": {"type": "string", "minLength": 8, "maxLength": 256},
        "program_id": {"type": "string", "format": "uuid"},
        "revision": {"type": "integer", "minimum": 1},
        "role_profile_ids": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
        "task_template_ids": {"type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}}
      }
    },
    "EnterpriseResourceV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "status", "updated_at"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "version": {"type": "integer", "minimum": 1},
        "status": {"enum": ["active", "paused", "archived", "scheduled", "published"]},
        "updated_at": {"type": "string", "format": "date-time"},
        "replayed": {"type": "boolean"}
      }
    }
  }
}
