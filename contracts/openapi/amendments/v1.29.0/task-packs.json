{
  "amendmentVersion": "1.29.0",
  "baseContractVersion": "1.28.0",
  "kind": "openapi-operation-version-extension",
  "compatibility": "versioned-client-additive",
  "operations": {
    "admin.task-packs.publish.v2": {
      "method": "POST",
      "path": "/v1/admin/task-packs",
      "authentication": "gateway_signed_active_session_plus_csrf",
      "authorization": "current_enterprise_owner_admin_or_program_manager",
      "idempotency": "required_encrypted_durable_response",
      "requestContentType": "application/vnd.lites.task-pack-publish.v2+json",
      "requestSchema": "TaskPackPublishV2",
      "responseContentType": "application/vnd.lites.enterprise-resource.v2+json",
      "responseSchema": "EnterpriseResourceV2"
    }
  },
  "schemas": {
    "TaskPackPublishV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "program_id", "revision", "name", "task_template_ids", "assignment"],
      "properties": {
        "request_id": {"type": "string", "minLength": 8, "maxLength": 200},
        "program_id": {"type": "string", "format": "uuid"},
        "revision": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "task_template_ids": {"type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
        "assignment": {"type": "object", "additionalProperties": true, "maxProperties": 100}
      }
    },
    "EnterpriseResourceV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "status", "updated_at"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "version": {"const": 1},
        "status": {"const": "published"},
        "updated_at": {"type": "string", "format": "date-time"},
        "replayed": {"type": "boolean"}
      }
    }
  },
  "integrity": "A task pack is a tenant-scoped append-only publication. Every referenced task template must exist and be active in the same tenant; duplicate program/revision publication is rejected."
}
