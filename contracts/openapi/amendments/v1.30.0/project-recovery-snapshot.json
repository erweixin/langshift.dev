{
  "schemaVersion": "1.0.0",
  "baseContractVersion": "1.29.0",
  "amendmentVersion": "1.30.0",
  "operations": {
    "projects.get.v2": {
      "method": "GET",
      "path": "/v1/projects/{project_id}",
      "authentication": "gateway_signed_session",
      "authorization": "tenant_user_owner_scope",
      "responseContentType": "application/vnd.lites.project-detail.v2+json",
      "responseSchema": "ProjectDetailResourceV2",
      "cachePolicy": "private_no_store"
    }
  },
  "schemas": {
    "ProjectEvaluationResourceV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation_id", "run_id", "status", "failure_reason", "evidence_id", "updated_at"],
      "properties": {
        "generation_id": {"type": "string", "format": "uuid"},
        "run_id": {"type": "string", "format": "uuid"},
        "status": {"enum": ["generating", "succeeded", "failed", "superseded"]},
        "failure_reason": {"type": ["string", "null"]},
        "evidence_id": {"type": ["string", "null"], "format": "uuid"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "ProjectMilestoneResourceV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sequence", "required", "status", "title", "result", "verification_test_run_id", "evidence_ids", "latest_evaluation", "completed_at", "updated_at"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "version": {"type": "integer", "minimum": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "required": {"type": "boolean"},
        "status": {"enum": ["planned", "in_progress", "submitted", "verified", "rework", "completed"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "result": {"type": ["string", "null"], "maxLength": 20000},
        "verification_test_run_id": {"type": ["string", "null"], "format": "uuid"},
        "evidence_ids": {"type": "array", "items": {"type": "string", "format": "uuid"}, "maxItems": 100},
        "latest_evaluation": {"anyOf": [{"$ref": "#/schemas/ProjectEvaluationResourceV2"}, {"type": "null"}]},
        "completed_at": {"type": ["string", "null"], "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "ProjectArtifactResourceV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "status", "artifact_kind", "title", "current_revision", "current_revision_id", "artifact_revision_ids", "updated_at"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "version": {"type": "integer", "minimum": 1},
        "status": {"enum": ["draft", "ready", "archived"]},
        "artifact_kind": {"enum": ["code", "writing", "design"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "current_revision": {"type": "integer", "minimum": 0},
        "current_revision_id": {"type": ["string", "null"], "format": "uuid"},
        "artifact_revision_ids": {"type": "array", "items": {"type": "string", "format": "uuid"}, "maxItems": 1000},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "ProjectExportResourceV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "version", "content_hash", "media_type", "byte_size", "failure_code", "created_at", "completed_at", "expires_at"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "status": {"enum": ["requested", "building", "ready", "failed", "expired"]},
        "version": {"type": "integer", "minimum": 1},
        "content_hash": {"type": ["string", "null"]},
        "media_type": {"type": ["string", "null"]},
        "byte_size": {"type": ["integer", "null"], "minimum": 1},
        "failure_code": {"type": ["string", "null"]},
        "created_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": ["string", "null"], "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "ProjectDetailResourceV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "brief", "workspace", "milestones", "artifacts", "latest_export"],
      "properties": {
        "project": {"$ref": "#/schemas/ProjectResourceV2"},
        "brief": {"type": "string", "minLength": 1, "maxLength": 10000},
        "workspace": {"anyOf": [{"$ref": "#/schemas/ProjectWorkspaceResourceV2"}, {"type": "null"}]},
        "milestones": {"type": "array", "items": {"$ref": "#/schemas/ProjectMilestoneResourceV2"}, "maxItems": 1000},
        "artifacts": {"type": "array", "items": {"$ref": "#/schemas/ProjectArtifactResourceV2"}, "maxItems": 1000},
        "latest_export": {"anyOf": [{"$ref": "#/schemas/ProjectExportResourceV2"}, {"type": "null"}]}
      }
    }
  }
}
