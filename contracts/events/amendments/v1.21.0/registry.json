{
  "amendmentVersion": "1.21.0",
  "baseContractVersion": "1.20.0",
  "compatibility": "additive",
  "schemas": {
    "SupportCaseCreated": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://lites.dev/events/SupportCaseCreated/1.json",
      "title": "SupportCaseCreated v1",
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "tenant_id", "user_id", "aggregate_id", "aggregate_version", "occurred_at", "payload"],
      "properties": {
        "event_id": {"type": "string", "format": "uuid"},
        "tenant_id": {"type": "string", "format": "uuid"},
        "user_id": {"type": "string", "format": "uuid"},
        "aggregate_id": {"type": "string", "format": "uuid"},
        "aggregate_version": {"const": 1},
        "occurred_at": {"type": "string", "format": "date-time"},
        "causation_id": {"type": "string"},
        "correlation_id": {"type": "string", "format": "uuid"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["case_id", "message_id", "category", "priority", "subject_ref", "subject_hash"],
          "properties": {
            "case_id": {"type": "string", "format": "uuid"},
            "message_id": {"type": "string", "format": "uuid"},
            "category": {"enum": ["product", "security", "privacy", "contract", "availability"]},
            "priority": {"enum": ["low", "normal", "high", "urgent"]},
            "subject_ref": {"type": "string", "minLength": 1, "maxLength": 2048},
            "subject_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      },
      "x-event-type": "SupportCaseCreated",
      "x-event-schema-version": 1,
      "x-compatibility": "additive",
      "x-owner": "product-support"
    },
    "SupportCaseReplied": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://lites.dev/events/SupportCaseReplied/1.json",
      "title": "SupportCaseReplied v1",
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "tenant_id", "user_id", "aggregate_id", "aggregate_version", "occurred_at", "payload"],
      "properties": {
        "event_id": {"type": "string", "format": "uuid"},
        "tenant_id": {"type": "string", "format": "uuid"},
        "user_id": {"type": "string", "format": "uuid"},
        "aggregate_id": {"type": "string", "format": "uuid"},
        "aggregate_version": {"type": "integer", "minimum": 2},
        "occurred_at": {"type": "string", "format": "date-time"},
        "causation_id": {"type": "string"},
        "correlation_id": {"type": "string", "format": "uuid"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["case_id", "message_id", "target_version"],
          "properties": {
            "case_id": {"type": "string", "format": "uuid"},
            "message_id": {"type": "string", "format": "uuid"},
            "target_version": {"type": "integer", "minimum": 2}
          }
        }
      },
      "x-event-type": "SupportCaseReplied",
      "x-event-schema-version": 1,
      "x-compatibility": "additive",
      "x-owner": "product-support"
    }
  }
}
