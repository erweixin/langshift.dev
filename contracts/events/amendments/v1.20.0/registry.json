{
  "amendmentVersion": "1.20.0",
  "baseContractVersion": "1.19.0",
  "compatibility": "additive",
  "schemas": {
    "SessionReauthenticated": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://lites.dev/events/SessionReauthenticated/1.json",
      "title": "SessionReauthenticated v1",
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "tenant_id", "user_id", "aggregate_id", "aggregate_version", "occurred_at", "payload"],
      "properties": {
        "event_id": {"type": "string", "format": "uuid"},
        "tenant_id": {"type": "string", "format": "uuid"},
        "user_id": {"type": "string", "format": "uuid"},
        "aggregate_id": {"type": "string", "format": "uuid"},
        "aggregate_version": {"type": "integer", "minimum": 2},
        "occurred_at": {"type": "string", "format": "date-time"},
        "causation_id": {"type": "string"},
        "correlation_id": {"type": "string", "format": "uuid"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["session_id", "session_version", "reauthenticated_at", "valid_until", "method"],
          "properties": {
            "session_id": {"type": "string", "format": "uuid"},
            "session_version": {"type": "integer", "minimum": 2},
            "reauthenticated_at": {"type": "string", "format": "date-time"},
            "valid_until": {"type": "string", "format": "date-time"},
            "method": {"const": "password"}
          }
        }
      },
      "x-event-type": "SessionReauthenticated",
      "x-event-schema-version": 1,
      "x-compatibility": "additive",
      "x-owner": "identity-platform"
    }
  }
}
