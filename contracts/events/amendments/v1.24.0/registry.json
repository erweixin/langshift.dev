{
  "amendmentVersion": "1.24.0",
  "baseContractVersion": "1.23.0",
  "compatibility": "additive",
  "schemas": {
    "SubjectErasureCompleted": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://lites.dev/events/SubjectErasureCompleted/1.json",
      "title": "SubjectErasureCompleted v1",
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "tenant_id", "user_id", "aggregate_id", "aggregate_version", "occurred_at", "correlation_id", "payload"],
      "properties": {
        "event_id": {"type": "string", "format": "uuid"},
        "tenant_id": {"type": "string", "format": "uuid"},
        "user_id": {"type": "string", "format": "uuid"},
        "aggregate_id": {"type": "string", "format": "uuid"},
        "aggregate_version": {"const": 2},
        "occurred_at": {"type": "string", "format": "date-time"},
        "causation_id": {"type": "string"},
        "correlation_id": {"type": "string", "format": "uuid"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject_id", "subject_version", "request_id", "recovery_epoch", "receipt_manifest_hash", "surface_count"],
          "properties": {
            "subject_id": {"type": "string", "format": "uuid"},
            "subject_version": {"const": 2},
            "request_id": {"type": "string", "format": "uuid"},
            "recovery_epoch": {"type": "string", "format": "uuid"},
            "receipt_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "surface_count": {"const": 6}
          }
        }
      },
      "x-event-type": "SubjectErasureCompleted",
      "x-event-schema-version": 1,
      "x-compatibility": "additive",
      "x-owner": "identity-privacy"
    }
  }
}
