            "revision_manifest": {"type": ["object", "null"]},
            "revision_manifest_hash": {"type": ["string", "null"]},
            "run_id": {"type": ["string", "null"]},
            "start_command_id": {"type": ["string", "null"]},
            "legacy_incomplete": {"type": "boolean"}
          },
          "allOf": [{
            "if": {"properties": {"legacy_incomplete": {"const": false}}, "required": ["legacy_incomplete"]},
            "then": {"properties": {
              "project_id": {"type": "string", "minLength": 1},
              "project_version": {"type": "integer", "minimum": 1},
              "workspace_binding_id": {"type": "string", "minLength": 1},
              "workspace_binding_version": {"type": "integer", "minimum": 1},
              "workspace_revision": {"type": "string", "minLength": 1},
              "workspace_manifest_hash": {"type": "string", "minLength": 1},
              "export_format": {"enum": ["html", "pdf", "zip"]},
              "revision_manifest": {"type": "object"},
              "revision_manifest_hash": {"type": "string", "minLength": 1},
              "run_id": {"type": "string", "minLength": 1},
              "start_command_id": {"type": "string", "minLength": 1}
            }}
          }]
        }
      },
      "x-event-type": "PortfolioExportRequested",
      "x-event-schema-version": 2,
      "x-compatibility": "additive-v2",
      "x-owner": "product-platform"
    },
