{
  "amendmentVersion": "1.14.0",
  "baseContractVersion": "1.13.0",
  "compatibility": "additive",
  "schemas": {
    "ConversationCreated": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://lites.dev/events/ConversationCreated/1.json",
      "title": "ConversationCreated v1",
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "tenant_id", "user_id", "aggregate_id", "aggregate_version", "occurred_at", "payload"],
      "properties": {
        "event_id": {"type": "string"},
        "tenant_id": {"type": "string"},
        "user_id": {"type": "string"},
        "aggregate_id": {"type": "string"},
        "aggregate_version": {"type": "integer", "minimum": 1},
        "occurred_at": {"type": "string", "format": "date-time"},
        "causation_id": {"type": "string"},
        "correlation_id": {"type": "string"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject_id", "subject_version", "conversation_id", "conversation_version", "mission_id", "title", "mode", "status", "created_at"],
          "properties": {
            "subject_id": {"type": "string", "minLength": 1},
            "subject_version": {"type": "integer", "const": 1},
            "conversation_id": {"type": "string", "minLength": 1},
            "conversation_version": {"type": "integer", "const": 1},
            "mission_id": {"type": "string", "minLength": 1},
            "title": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
            "mode": {"enum": ["coach", "task", "project"]},
            "status": {"const": "active"},
            "created_at": {"type": "string", "format": "date-time"}
          }
        }
      },
      "x-event-type": "ConversationCreated",
      "x-event-schema-version": 1,
      "x-compatibility": "additive",
      "x-owner": "agent-platform"
    }
  }
}
