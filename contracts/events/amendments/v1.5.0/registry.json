            "provider_request_id": {"type": ["string", "null"]}, "error_class": {"type": ["string", "null"]},
            "visible_output_started_at": {"type": ["string", "null"], "format": "date-time"},
            "reconciliation_due_at": {"type": ["string", "null"], "format": "date-time"},
            "byok": {"type": ["boolean", "null"]}, "status": {"type": "string", "minLength": 1},
            "legacy_incomplete": {"type": "boolean"}
          },
          "allOf": [{
            "if": {"properties": {"legacy_incomplete": {"const": false}}, "required": ["legacy_incomplete"]},
            "then": {"properties": {
              "ordinal": {"type": "integer", "minimum": 1}, "model_version": {"type": "string", "minLength": 1},
              "request_hash": {"type": "string", "minLength": 1}, "pricing_version": {"type": "string", "minLength": 1},
              "usage_status": {"enum": ["confirmed", "estimated", "unknown"]}, "byok": {"type": "boolean"}
            }}
          }]
        }
      },
