            "then":{"properties":{"profile_snapshot_id":{"type":"string","pattern":"^behavior-[0-9a-f]{64}$"},"behavior_profile":{"type":"string"},"behavior_environment":{"type":"string"},"behavior_channel_id":{"type":"string","minLength":1},"behavior_channel_sequence":{"type":"integer"}}},
            "else":{"properties":{"behavior_profile":{"type":"null"},"behavior_environment":{"type":"null"},"behavior_channel_id":{"type":"null"},"behavior_channel_sequence":{"type":"null"}}}
          }]
