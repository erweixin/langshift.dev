        "payload":{"type":"object","additionalProperties":false,
          "required":["subject_id","subject_version","request_id","command_id","run_id","conversation_id","run_version","idempotency_scope","idempotency_key_hash","due_at","profile_snapshot_id","behavior_profile","behavior_environment","behavior_channel_id","behavior_channel_sequence","legacy_behavior_binding"],
          "properties":{
            "subject_id":{"type":"string","minLength":1},"subject_version":{"type":"integer","minimum":1},"request_id":{"type":"string","minLength":1},"command_id":{"type":["string","null"]},"run_id":{"type":"string","minLength":1},"conversation_id":{"type":"string","minLength":1},"run_version":{"type":"integer","minimum":1},"idempotency_scope":{"type":"string","minLength":1},"idempotency_key_hash":{"type":"string","minLength":1},"due_at":{"type":"string","format":"date-time"},
