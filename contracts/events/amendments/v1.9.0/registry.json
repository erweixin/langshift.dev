{
  "amendmentVersion":"1.9.0",
  "baseContractVersion":"1.8.0",
  "compatibility":"additive",
  "schemas":{
    "RunAcceptedV2":{
      "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://lites.dev/events/RunAccepted/2.json",
      "title":"RunAccepted v2","type":"object","additionalProperties":false,
