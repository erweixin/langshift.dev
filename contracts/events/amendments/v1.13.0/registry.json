{
  "amendmentVersion": "1.13.0",
  "baseContractVersion": "1.12.0",
  "compatibility": "additive",
  "schemas": {
    "ChildRunSpawned": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://lites.dev/events/ChildRunSpawned/1.json",
      "title": "ChildRunSpawned v1",
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "tenant_id", "user_id", "aggregate_id", "aggregate_version", "occurred_at", "payload"],
      "properties": {
        "event_id": {"type": "string"},
        "tenant_id": {"type": "string"},
        "user_id": {"type": "string"},
        "aggregate_id": {"type": "string"},
        "aggregate_version": {"type": "integer", "minimum": 1},
        "occurred_at": {"type": "string", "format": "date-time"},
        "causation_id": {"type": "string"},
        "correlation_id": {"type": "string"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject_id", "subject_version", "parent_run_id", "parent_run_version", "root_run_id", "child_group_id", "step_id", "join_policy", "quorum_count", "plan_result_hash", "children"],
          "properties": {
            "subject_id": {"type": "string", "minLength": 1},
            "subject_version": {"type": "integer", "const": 1},
            "parent_run_id": {"type": "string", "minLength": 1},
            "parent_run_version": {"type": "integer", "minimum": 1},
            "root_run_id": {"type": "string", "minLength": 1},
            "child_group_id": {"type": "string", "minLength": 1},
            "step_id": {"type": "string", "minLength": 1, "maxLength": 256},
            "join_policy": {"enum": ["all", "any", "quorum"]},
            "quorum_count": {"type": "integer", "minimum": 1, "maximum": 10},
            "plan_result_hash": {"type": "string", "minLength": 1},
            "children": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["child_run_id", "spawn_tool_call_id", "required", "depth", "profile_snapshot_id", "budget_microunits", "due_at"],
                "properties": {
                  "child_run_id": {"type": "string", "minLength": 1},
                  "spawn_tool_call_id": {"type": "string", "minLength": 1},
                  "required": {"type": "boolean"},
                  "depth": {"type": "integer", "minimum": 1, "maximum": 5},
                  "profile_snapshot_id": {"type": "string", "pattern": "^behavior-[0-9a-f]{64}$"},
                  "budget_microunits": {"type": "integer", "minimum": 1},
                  "due_at": {"type": "string", "format": "date-time"}
                }
              }
            }
          }
        }
      },
      "x-event-type": "ChildRunSpawned",
      "x-event-schema-version": 1,
      "x-compatibility": "additive",
      "x-owner": "agent-platform"
    },
    "ChildRunCompleted": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://lites.dev/events/ChildRunCompleted/1.json",
      "title": "ChildRunCompleted v1",
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "tenant_id", "user_id", "aggregate_id", "aggregate_version", "occurred_at", "payload"],
      "properties": {
        "event_id": {"type": "string"},
        "tenant_id": {"type": "string"},
        "user_id": {"type": "string"},
        "aggregate_id": {"type": "string"},
        "aggregate_version": {"type": "integer", "minimum": 1},
        "occurred_at": {"type": "string", "format": "date-time"},
        "causation_id": {"type": "string"},
        "correlation_id": {"type": "string"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject_id", "subject_version", "child_run_id", "child_run_version", "parent_run_id", "root_run_id", "child_group_id", "terminal_status", "result_summary_ref", "result_summary_hash", "payload_hmac", "completed_at"],
          "properties": {
            "subject_id": {"type": "string", "minLength": 1},
            "subject_version": {"type": "integer", "const": 1},
            "child_run_id": {"type": "string", "minLength": 1},
            "child_run_version": {"type": "integer", "minimum": 1},
            "parent_run_id": {"type": "string", "minLength": 1},
            "root_run_id": {"type": "string", "minLength": 1},
            "child_group_id": {"type": "string", "minLength": 1},
            "terminal_status": {"enum": ["succeeded", "failed", "cancelled", "expired"]},
            "result_summary_ref": {"type": "string", "minLength": 1},
            "result_summary_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "payload_hmac": {"type": "string", "minLength": 1},
            "completed_at": {"type": "string", "format": "date-time"}
          }
        }
      },
      "x-event-type": "ChildRunCompleted",
      "x-event-schema-version": 1,
      "x-compatibility": "additive",
      "x-owner": "agent-platform"
    },
    "ChildGroupJoined": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://lites.dev/events/ChildGroupJoined/1.json",
      "title": "ChildGroupJoined v1",
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "tenant_id", "user_id", "aggregate_id", "aggregate_version", "occurred_at", "payload"],
      "properties": {
        "event_id": {"type": "string"},
        "tenant_id": {"type": "string"},
        "user_id": {"type": "string"},
        "aggregate_id": {"type": "string"},
        "aggregate_version": {"type": "integer", "minimum": 1},
        "occurred_at": {"type": "string", "format": "date-time"},
        "causation_id": {"type": "string"},
        "correlation_id": {"type": "string"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject_id", "subject_version", "group_id", "group_version", "parent_run_id", "parent_run_version", "root_run_id", "join_policy", "quorum_count", "join_reason", "completed_children", "cancelled_child_run_ids", "continuation_id", "resume_command_id", "released_budget_microunits", "joined_at"],
          "properties": {
            "subject_id": {"type": "string", "minLength": 1},
            "subject_version": {"type": "integer", "const": 1},
            "group_id": {"type": "string", "minLength": 1},
            "group_version": {"type": "integer", "minimum": 1},
            "parent_run_id": {"type": "string", "minLength": 1},
            "parent_run_version": {"type": "integer", "minimum": 1},
            "root_run_id": {"type": "string", "minLength": 1},
            "join_policy": {"enum": ["all", "any", "quorum"]},
            "quorum_count": {"type": "integer", "minimum": 1, "maximum": 10},
            "join_reason": {"enum": ["policy_satisfied", "required_children_terminal"]},
            "completed_children": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["child_run_id", "required", "terminal_status", "result_summary_hash"],
                "properties": {
                  "child_run_id": {"type": "string", "minLength": 1},
                  "required": {"type": "boolean"},
                  "terminal_status": {"enum": ["succeeded", "failed", "cancelled", "expired"]},
                  "result_summary_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                }
              }
            },
            "cancelled_child_run_ids": {"type": "array", "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "continuation_id": {"type": "string", "minLength": 1},
            "resume_command_id": {"type": "string", "minLength": 1},
            "released_budget_microunits": {"type": "integer", "minimum": 0},
            "joined_at": {"type": "string", "format": "date-time"}
          }
        }
      },
      "x-event-type": "ChildGroupJoined",
      "x-event-schema-version": 1,
      "x-compatibility": "additive",
      "x-owner": "agent-platform"
    }
  }
}
