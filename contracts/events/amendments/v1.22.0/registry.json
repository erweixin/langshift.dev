{
  "amendmentVersion": "1.22.0",
  "baseContractVersion": "1.21.0",
  "compatibility": "additive",
  "schemas": {
    "AuditExportCreated": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://lites.dev/events/AuditExportCreated/1.json",
      "title": "AuditExportCreated v1",
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "tenant_id", "user_id", "aggregate_id", "aggregate_version", "occurred_at", "payload"],
      "properties": {
        "event_id": {"type": "string", "format": "uuid"},
        "tenant_id": {"type": "string", "format": "uuid"},
        "user_id": {"type": "string", "format": "uuid"},
        "aggregate_id": {"type": "string", "format": "uuid"},
        "aggregate_version": {"const": 1},
        "occurred_at": {"type": "string", "format": "date-time"},
        "causation_id": {"type": "string"},
        "correlation_id": {"type": "string", "format": "uuid"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["export_id", "format", "record_count", "content_hash", "period_start", "period_end"],
          "properties": {
            "export_id": {"type": "string", "format": "uuid"},
            "format": {"enum": ["jsonl", "csv"]},
            "record_count": {"type": "integer", "minimum": 0, "maximum": 100000},
            "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "period_start": {"type": "string", "format": "date-time"},
            "period_end": {"type": "string", "format": "date-time"}
          }
        }
      },
      "x-event-type": "AuditExportCreated",
      "x-event-schema-version": 1,
      "x-compatibility": "additive",
      "x-owner": "commercial-control-plane"
    }
  }
}
