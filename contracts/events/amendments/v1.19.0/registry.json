{
  "amendmentVersion": "1.19.0",
  "baseContractVersion": "1.18.0",
  "compatibility": "additive",
  "schemas": {
    "EntitlementProposed": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://lites.dev/events/EntitlementProposed/1.json",
      "title": "EntitlementProposed v1",
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "tenant_id", "user_id", "aggregate_id", "aggregate_version", "occurred_at", "payload"],
      "properties": {
        "event_id": {"type": "string", "format": "uuid"},
        "tenant_id": {"type": "string", "format": "uuid"},
        "user_id": {"type": "string", "format": "uuid"},
        "aggregate_id": {"type": "string", "format": "uuid"},
        "aggregate_version": {"const": 1},
        "occurred_at": {"type": "string", "format": "date-time"},
        "causation_id": {"type": "string"},
        "correlation_id": {"type": "string"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["proposal_id", "contract_id", "target_contract_version", "entitlement_key", "target_entitlement_version", "limit_value", "config_hash", "proposal_hash", "reason_ref", "reason_hash", "expires_at"],
          "properties": {
            "proposal_id": {"type": "string", "format": "uuid"},
            "contract_id": {"type": "string", "format": "uuid"},
            "target_contract_version": {"type": "integer", "minimum": 1},
            "entitlement_key": {"enum": ["programs", "cohorts", "role_packs", "aggregate_analytics", "audit_export", "private_delivery", "commercial_license", "support_tier"]},
            "target_entitlement_version": {"type": "integer", "minimum": 0},
            "limit_value": {"type": ["integer", "null"], "minimum": 0},
            "config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "proposal_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "reason_ref": {"type": "string", "minLength": 1, "maxLength": 2048},
            "reason_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "expires_at": {"type": "string", "format": "date-time"}
          }
        }
      },
      "x-event-type": "EntitlementProposed",
      "x-event-schema-version": 1,
      "x-compatibility": "additive",
      "x-owner": "contract-platform"
    },
    "EntitlementApprovalGranted": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://lites.dev/events/EntitlementApprovalGranted/1.json",
      "title": "EntitlementApprovalGranted v1",
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "tenant_id", "user_id", "aggregate_id", "aggregate_version", "occurred_at", "payload"],
      "properties": {
        "event_id": {"type": "string", "format": "uuid"},
        "tenant_id": {"type": "string", "format": "uuid"},
        "user_id": {"type": "string", "format": "uuid"},
        "aggregate_id": {"type": "string", "format": "uuid"},
        "aggregate_version": {"const": 1},
        "occurred_at": {"type": "string", "format": "date-time"},
        "causation_id": {"type": "string"},
        "correlation_id": {"type": "string"},
        "payload": {"$ref": "#/$defs/decision"}
      },
      "$defs": {
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision_id", "proposal_id", "decision", "proposal_hash", "target_contract_version", "target_entitlement_version", "permission_snapshot", "decided_at"],
          "properties": {
            "decision_id": {"type": "string", "format": "uuid"},
            "proposal_id": {"type": "string", "format": "uuid"},
            "decision": {"const": "approve"},
            "proposal_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "target_contract_version": {"type": "integer", "minimum": 1},
            "target_entitlement_version": {"type": "integer", "minimum": 0},
            "permission_snapshot": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "decided_at": {"type": "string", "format": "date-time"}
          }
        }
      },
      "x-event-type": "EntitlementApprovalGranted",
      "x-event-schema-version": 1,
      "x-compatibility": "additive",
      "x-owner": "contract-platform"
    },
    "EntitlementApprovalRejected": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://lites.dev/events/EntitlementApprovalRejected/1.json",
      "title": "EntitlementApprovalRejected v1",
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "tenant_id", "user_id", "aggregate_id", "aggregate_version", "occurred_at", "payload"],
      "properties": {
        "event_id": {"type": "string", "format": "uuid"},
        "tenant_id": {"type": "string", "format": "uuid"},
        "user_id": {"type": "string", "format": "uuid"},
        "aggregate_id": {"type": "string", "format": "uuid"},
        "aggregate_version": {"const": 1},
        "occurred_at": {"type": "string", "format": "date-time"},
        "causation_id": {"type": "string"},
        "correlation_id": {"type": "string"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision_id", "proposal_id", "decision", "proposal_hash", "target_contract_version", "target_entitlement_version", "permission_snapshot", "decided_at"],
          "properties": {
            "decision_id": {"type": "string", "format": "uuid"},
            "proposal_id": {"type": "string", "format": "uuid"},
            "decision": {"const": "reject"},
            "proposal_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "target_contract_version": {"type": "integer", "minimum": 1},
            "target_entitlement_version": {"type": "integer", "minimum": 0},
            "permission_snapshot": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "decided_at": {"type": "string", "format": "date-time"}
          }
        }
      },
      "x-event-type": "EntitlementApprovalRejected",
      "x-event-schema-version": 1,
      "x-compatibility": "additive",
      "x-owner": "contract-platform"
    },
    "EntitlementProposalExecuted": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://lites.dev/events/EntitlementProposalExecuted/1.json",
      "title": "EntitlementProposalExecuted v1",
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "tenant_id", "user_id", "aggregate_id", "aggregate_version", "occurred_at", "payload"],
      "properties": {
        "event_id": {"type": "string", "format": "uuid"},
        "tenant_id": {"type": "string", "format": "uuid"},
        "user_id": {"type": "string", "format": "uuid"},
        "aggregate_id": {"type": "string", "format": "uuid"},
        "aggregate_version": {"const": 2},
        "occurred_at": {"type": "string", "format": "date-time"},
        "causation_id": {"type": "string"},
        "correlation_id": {"type": "string"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["proposal_id", "contract_id", "contract_version", "entitlement_id", "entitlement_version", "proposal_hash", "approval_count", "executed_at"],
          "properties": {
            "proposal_id": {"type": "string", "format": "uuid"},
            "contract_id": {"type": "string", "format": "uuid"},
            "contract_version": {"type": "integer", "minimum": 1},
            "entitlement_id": {"type": "string", "format": "uuid"},
            "entitlement_version": {"type": "integer", "minimum": 1},
            "proposal_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "approval_count": {"const": 2},
            "executed_at": {"type": "string", "format": "date-time"}
          }
        }
      },
      "x-event-type": "EntitlementProposalExecuted",
      "x-event-schema-version": 1,
      "x-compatibility": "additive",
      "x-owner": "contract-platform"
    }
  }
}
