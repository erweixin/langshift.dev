{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contractVersion": "1.0.0",
  "brand": {
    "name": "Lites",
    "defaultLocale": "en",
    "supportedLocales": ["en", "zh-CN"],
    "promise": {
      "en": "You are not starting over. You are transferring what you already know.",
      "zh-CN": "你不是从零开始，你是在迁移。"
    }
  },
  "growthLoop": ["goal", "map", "learn", "practice", "create", "evidence"],
  "evidenceLoop": "Evidence recalibrates the next Goal, Map, and task selection.",
  "releasePolicy": "Only a complete GA release may be published. Engineering stages are internal gates, not product editions.",
  "commercialBoundary": {
    "identity": "Built-in email and password only",
    "collection": "Offline enterprise contracting and settlement only",
    "licensing": ["AGPL-3.0", "commercial"]
  },
  "personas": ["anonymous_visitor", "personal_member", "enterprise_member", "reviewer", "program_manager", "contract_admin", "tenant_admin", "tenant_owner", "platform_operator"],
  "dataClasses": ["public", "internal", "confidential", "restricted", "secret"],
  "capabilityDomains": [
    "anonymous_acquisition", "identity", "tenant_and_membership", "growth", "agent_execution",
    "workspace_and_artifact", "memory_and_retrieval", "enterprise", "contracts_and_usage",
    "privacy_and_governance", "delivery_and_operations"
  ]
}
