{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contractVersion": "1.0.0",
  "enterpriseAggregation": {
    "minimumCellSize": 5,
    "minimumComplementSize": 5,
    "suppression":"stable_per_snapshot",
    "queryBudget":{"maxQueriesPerSnapshotPerTenant":100,"adaptiveSequenceMax":100},
    "metrics":["active_members","task_completion_rate","weekly_loop_completion_rate","project_completion_rate","aggregate_credit_usage"],
    "dimensions":["program","cohort","role_pack","locale","coarse_week"],
    "timeBuckets":["week","month","quarter"],
    "forbidden":["member_id","email","free_text","conversation","reflection","memory","workspace","evidence_body","arbitrary_sql","member_drilldown","employment_decision"]
  },
  "shareGrant":"Private content is unreadable outside the owner context until an explicit, scoped, revocable grant exists.",
  "twoPersonRule": {
    "operations":["repair_command","contract_activation","contract_change"],
    "approvalsRequired":2,
    "initiatorMayApprove":false,
    "distinctActivePrincipals":true,
    "reauthenticationMaxAgeSeconds":300,
    "binding":["proposal_hash","target_resource_version","expires_at","permission_snapshot"],
    "invalidateOn":["proposal_change","target_version_change","role_change","account_deactivation","expiry"]
  }
}
