{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contractVersion": "1.0.0",
  "rules": [
    {"record":"anonymous_payload","class":"restricted","retention":"PT24H unless reserved","deletion":"claim saga receipts or expiry","immutableAudit":"minimal fact without body"},
    {"record":"password_or_raw_token","class":"secret","retention":"never stored","deletion":"not applicable","immutableAudit":"never include"},
    {"record":"session_token_hash","class":"secret","retention":"until expiry or revocation plus P30D security audit","deletion":"account erasure schedule","immutableAudit":"token hash excluded"},
    {"record":"event_payload_envelope","class":"restricted","retention":"contract and tenant policy","deletion":"crypto-shred payload; retain minimal event fact","immutableAudit":"event envelope"},
    {"record":"memory_document","class":"restricted","retention":"user policy","deletion":"projection delete plus MemoryDeleted event","immutableAudit":"non-body deletion fact"},
    {"record":"workspace_artifact","class":"restricted","retention":"user policy and active export references","deletion":"object deletion receipt plus key destruction","immutableAudit":"content hash and receipt"},
    {"record":"security_audit","class":"confidential","retention":"P400D cloud default, configurable self-hosted","deletion":"policy expiry; no sensitive body","immutableAudit":"append-only"},
    {"record":"provider_request_body","class":"restricted","retention":"not retained by platform beyond encrypted diagnostic window","deletion":"payload receipt and provider policy","immutableAudit":"manifest and hashes only"},
    {"record":"account_export","class":"restricted","retention":"P7D after delivery","deletion":"object receipt","immutableAudit":"request and delivery facts"},
    {"record":"account_erasure_request","class":"confidential","retention":"P400D after completion","deletion":"retain non-body legal/audit fact","immutableAudit":"receipt manifest"},
    {"record":"aggregate_snapshot","class":"confidential","retention":"contract policy","deletion":"tenant deletion; stable suppression metadata retained with audit","immutableAudit":"query budget ledger"}
  ],
  "backupRule":"Deleted subjects remain on a tombstone list and are re-erased after any restore until immutable backup retention expires.",
  "logRule":"Passwords, raw tokens, BYOK plaintext, private bodies, payload encryption keys, and email bodies are prohibited."
}
