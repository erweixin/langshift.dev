{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://lites.dev/schemas/pilot-cohort-manifest.json",
  "type":"object",
  "additionalProperties":false,
  "required":["protocolVersion","cohortId","behaviorManifestHash","recruitmentOpenedAt","recruitmentClosedAt","participantCount","localeCounts","stratumCounts","consentRecordHash","subjectManifestHash"],
  "properties":{
    "protocolVersion":{"const":"1.0.0"},
    "cohortId":{"type":"string","minLength":1},
    "behaviorManifestHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "recruitmentOpenedAt":{"type":"string","format":"date-time"},
    "recruitmentClosedAt":{"type":"string","format":"date-time"},
    "participantCount":{"type":"integer","minimum":60},
    "localeCounts":{"type":"object","additionalProperties":false,"required":["en","zh-CN"],"properties":{"en":{"type":"integer","minimum":30},"zh-CN":{"type":"integer","minimum":30}}},
    "stratumCounts":{"type":"array","minItems":6,"items":{"type":"object","additionalProperties":false,"required":["transition","en","zh-CN"],"properties":{"transition":{"type":"string"},"en":{"type":"integer","minimum":5},"zh-CN":{"type":"integer","minimum":5}}}},
    "consentRecordHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "subjectManifestHash":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  }
}
