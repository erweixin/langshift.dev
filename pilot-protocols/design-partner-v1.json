{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "protocolVersion": "1.0.0",
  "status": "frozen_before_recruitment",
  "durationDays": 28,
  "minimumConsentedParticipants": 60,
  "localeMinimums": {"en":30,"zh-CN":30},
  "transitionGroupMinimum": 6,
  "perGroupPerLocaleMinimum": 5,
  "recruitmentStrata":[
    {"transition":"frontend_to_ai_application_engineer","minimum":{"en":5,"zh-CN":5}},
    {"transition":"backend_to_ai_infra_engineer","minimum":{"en":5,"zh-CN":5}},
    {"transition":"designer_to_product_designer","minimum":{"en":5,"zh-CN":5}},
    {"transition":"data_analyst_to_analytics_engineer","minimum":{"en":5,"zh-CN":5}},
    {"transition":"pm_to_ai_product_manager","minimum":{"en":5,"zh-CN":5}},
    {"transition":"support_to_customer_engineer","minimum":{"en":5,"zh-CN":5}}
  ],
  "eligibility":{
    "include":["age 18 or older","currently in or recently practiced the source role","actively considering the target role","can participate for 28 days","can give informed consent in English or Simplified Chinese"],
    "exclude":["direct project team member","unable to use an isolated pilot account","expects product use for hiring or employment-rights decisions","declines behavioral event collection required for the frozen metrics"]
  },
  "recruitmentChannels":["professional communities","design-partner referrals","direct research invitations"],
  "compensationRule":"Compensation, if offered, is fixed before recruitment and is not conditional on favorable feedback or metric completion.",
  "environment":"isolated design-partner tenants",
  "tasks":["anonymous_onboarding","capability_confirmation_or_correction","route_acceptance","first_daily_loop","three_weekly_loops","bounded_create_project"],
  "metrics": [
    {"id":"route_preview_reached","denominator":"started_anonymous_onboarding","threshold":0.75},
    {"id":"route_understood_and_accepted","denominator":"completed_route_preview","threshold":0.80},
    {"id":"first_loop_within_48h","denominator":"accepted_route","threshold":0.70},
    {"id":"three_loops_in_week_one","denominator":"accepted_route","threshold":0.60},
    {"id":"bounded_project_by_day_28","denominator":"accepted_route","threshold":0.40}
  ],
  "groupGapMaximumPoints":15,
  "zeroTolerance":["cross_tenant_access","private_content_misshare","ungrounded_capability_upgrade","unapproved_side_effect","unresolved_p0","unresolved_p1"],
  "consent":"Explicit consent is required before behavioral collection; withdrawal stops collection and triggers protocol deletion.",
  "consentDocument":"pilot-protocols/consent-v1.json",
  "dataMinimization":["pseudonymous_subject_id","event names and timestamps","predefined task outcomes","rubric scores","no conversation body","no reflection body","no BYOK or secrets"],
  "exitRules":["participant withdrawal","security boundary event","material product behavior change","protocol deviation","safety concern"],
  "failureRule":"Any threshold miss requires a corrected product and a new frozen cohort; metrics and denominators cannot be changed after recruitment starts."
}
