{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lites.dev/schemas/pilot-metrics-evidence.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolVersion", "cohortId", "sourceCommit", "rcHash", "behaviorManifestHash", "pilotStartedAt", "pilotCompletedAt", "imageLockSha256", "configSnapshotSha256", "analysisCodeSha256", "consent", "metrics", "localeMetrics", "stratumMetrics", "zeroTolerance", "protocolDeviations"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "protocolVersion": {"const": "1.0.0"},
    "cohortId": {"type": "string", "minLength": 1},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "rcHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "behaviorManifestHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pilotStartedAt": {"type": "string", "format": "date-time"},
    "pilotCompletedAt": {"type": "string", "format": "date-time"},
    "imageLockSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "configSnapshotSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "analysisCodeSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consentedParticipants", "retainedParticipants", "withdrawnParticipants", "withdrawalDeletionReceipts", "missingConsentRecords", "prohibitedFieldsFound", "consentRecordHash", "subjectManifestHash"],
      "properties": {
        "consentedParticipants": {"type": "integer", "minimum": 60},
        "retainedParticipants": {"type": "integer", "minimum": 0},
        "withdrawnParticipants": {"type": "integer", "minimum": 0},
        "withdrawalDeletionReceipts": {"type": "integer", "minimum": 0},
        "missingConsentRecords": {"type": "integer", "minimum": 0},
        "prohibitedFieldsFound": {"type": "integer", "minimum": 0},
        "consentRecordHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "subjectManifestHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "metrics": {"$ref": "#/$defs/metricRows"},
    "localeMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh-CN"],
      "properties": {"en": {"$ref": "#/$defs/metricRows"}, "zh-CN": {"$ref": "#/$defs/metricRows"}}
    },
    "stratumMetrics": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["transition", "metrics"],
        "properties": {"transition": {"type": "string", "minLength": 1}, "metrics": {"$ref": "#/$defs/metricRows"}}
      }
    },
    "zeroTolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cross_tenant_access", "private_content_misshare", "ungrounded_capability_upgrade", "unapproved_side_effect", "unresolved_p0", "unresolved_p1"],
      "properties": {
        "cross_tenant_access": {"type": "integer", "minimum": 0},
        "private_content_misshare": {"type": "integer", "minimum": 0},
        "ungrounded_capability_upgrade": {"type": "integer", "minimum": 0},
        "unapproved_side_effect": {"type": "integer", "minimum": 0},
        "unresolved_p0": {"type": "integer", "minimum": 0},
        "unresolved_p1": {"type": "integer", "minimum": 0}
      }
    },
    "protocolDeviations": {"type": "array", "maxItems": 0}
  },
  "$defs": {
    "metricRows": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "numerator", "denominator"],
        "properties": {
          "id": {"enum": ["route_preview_reached", "route_understood_and_accepted", "first_loop_within_48h", "three_loops_in_week_one", "bounded_project_by_day_28"]},
          "numerator": {"type": "integer", "minimum": 0},
          "denominator": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
