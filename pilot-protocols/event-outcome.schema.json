{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lites.dev/schemas/pilot-event-outcome.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "subjectHash", "locale", "transition", "consentStatus", "withdrawalDeletionReceiptHash", "startedAnonymousOnboarding", "withdrawalExcludes", "outcomes", "zeroTolerance"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "subjectHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "locale": {"enum": ["en", "zh-CN"]},
    "transition": {"type": "string", "minLength": 1},
    "consentStatus": {"enum": ["retained", "withdrawn"]},
    "withdrawalDeletionReceiptHash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "startedAnonymousOnboarding": {"type": "boolean"},
    "withdrawalExcludes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["route_understood_and_accepted", "first_loop_within_48h", "three_loops_in_week_one", "bounded_project_by_day_28"]}
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_preview_reached", "route_understood_and_accepted", "first_loop_within_48h", "three_loops_in_week_one", "bounded_project_by_day_28"],
      "properties": {
        "route_preview_reached": {"$ref": "#/$defs/outcome"},
        "route_understood_and_accepted": {"$ref": "#/$defs/outcome"},
        "first_loop_within_48h": {"$ref": "#/$defs/outcome"},
        "three_loops_in_week_one": {"$ref": "#/$defs/outcome"},
        "bounded_project_by_day_28": {"$ref": "#/$defs/outcome"}
      }
    },
    "zeroTolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cross_tenant_access", "private_content_misshare", "ungrounded_capability_upgrade", "unapproved_side_effect", "unresolved_p0", "unresolved_p1"],
      "properties": {
        "cross_tenant_access": {"type": "integer", "minimum": 0},
        "private_content_misshare": {"type": "integer", "minimum": 0},
        "ungrounded_capability_upgrade": {"type": "integer", "minimum": 0},
        "unapproved_side_effect": {"type": "integer", "minimum": 0},
        "unresolved_p0": {"type": "integer", "minimum": 0},
        "unresolved_p1": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "achieved"],
      "properties": {"eligible": {"type": "boolean"}, "achieved": {"type": "boolean"}}
    }
  }
}
